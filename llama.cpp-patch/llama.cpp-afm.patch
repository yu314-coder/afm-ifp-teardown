+                cb(Kcur, "Kcur", il);
+                cb(Vcur, "Vcur", il);
+                cur = build_attn(inp_attn, mm16 ? nullptr : layer.wo, NULL, Qcur, Kcur, Vcur, nullptr, nullptr, nullptr,
+                                 attn_scale, il);
+            } else {
+                cur = build_attn(inp_attn, mm16 ? nullptr : layer.wo, NULL, Qcur, nullptr, nullptr, nullptr, nullptr, nullptr,
+                                 attn_scale, il);
+            }
+            if (mm16) { cur = r16(build_lora_mm(layer.wo, r16(cur))); }
+        }
+
+        if (il == n_layer - 1 && inp_out_ids) {
+            cur = ggml_get_rows(ctx0, cur, inp_out_ids);
+            x   = ggml_get_rows(ctx0, x,   inp_out_ids);
+            if (router_logits) {
+                router_logits = ggml_get_rows(ctx0, router_logits, inp_out_ids);
+            }
+        }
+
+        cur = build_norm(cur, layer.attn_post_norm, NULL, LLM_NORM_RMS, il);
+        if (il == 0 && getenv("AFM_L0_ATTN_MUL")) { cur = ggml_scale(ctx0, cur, afm_env_f("AFM_L0_ATTN_MUL", 1.0f)); }   // research
+        if (f16_act >= 3) { cur = f16r(cur); }
+        ggml_tensor * hp = ggml_add(ctx0, x, cur);
+        if (f16_act >= 1) { hp = f16r(hp); }
+        cb(hp, "attn_out", il);
+
+        ggml_tensor * y = build_norm(hp, layer.ffn_norm, NULL, LLM_NORM_RMS, il);
+        if (il == n_dense && route_at_ffn) { route_block(y); }   // research: router on the layer-12 FFN input
+        cb(y, "ffn_in", il);
+
+        ggml_tensor * f;
+        if (il < n_dense && lut_silu) {
+            f = ffn_lut(y, layer.ffn_up, layer.ffn_gate, layer.ffn_down);
+        } else if (il < n_dense && ane_silu) {
+            f = ffn_ane(y, layer.ffn_up, layer.ffn_gate, layer.ffn_down);
+        } else if (il < n_dense) {
+            f = build_ffn(y,
+                    layer.ffn_up,   NULL, NULL,
+                    layer.ffn_gate, NULL, NULL,
+                    layer.ffn_down, NULL, NULL,
+                    NULL, LLM_FFN_SILU, LLM_FFN_PAR, il);
+        } else {
+            ggml_tensor * up_s = layer.ffn_up_shexp, * gate_s = layer.ffn_gate_shexp, * down_s = layer.ffn_down_shexp;
+            if (n_static * hparams.n_ff_exp < (int64_t) hparams.n_ff_shexp) {
+                // ifp1/ifp2: the first n_static always-on experts (256-aligned, so whole Q2_K blocks)
+                const int64_t w = n_static * hparams.n_ff_exp;
+                up_s   = ggml_view_2d(ctx0, up_s,   up_s->ne[0],   w, up_s->nb[1],   0);
+                gate_s = ggml_view_2d(ctx0, gate_s, gate_s->ne[0], w, gate_s->nb[1], 0);
+                down_s = ggml_view_2d(ctx0, down_s, w, down_s->ne[1], down_s->nb[1], 0);
+            }
+            ggml_tensor * shared = lut_silu ? ffn_lut(y, up_s, gate_s, down_s) :
+                                   ane_silu ? ffn_ane(y, up_s, gate_s, down_s) :
+                build_ffn(y,
+                    up_s,   NULL, NULL,
+                    gate_s, NULL, NULL,
+                    down_s, NULL, NULL,
+                    NULL, LLM_FFN_SILU, LLM_FFN_PAR, il);
+            cb(shared, "ffn_shexp", il);
+
+            const int64_t n_tok = y->ne[1];
+            ggml_tensor * lg = ggml_view_2d(ctx0, router_logits, n_expert, n_tok, router_logits->nb[1],
+                                            (size_t) (il - n_dense) * n_expert * ggml_element_size(router_logits));
+            lg = ggml_cont(ctx0, lg);
+            cb(lg, "ffn_moe_logits", il);
+            ggml_tensor * sel = ggml_argsort_top_k(ctx0, lg, n_used); // [n_expert_used, n_tok]
+            cb(sel, "ffn_moe_topk", il);
+
+            ggml_tensor * y3 = ggml_reshape_3d(ctx0, y, n_embd, 1, n_tok);
+            ggml_tensor * up = r16(build_lora_mm_id(layer.ffn_up_exps,   y3, sel)); // [n_ff_exp, n_used, n_tok]
+            ggml_tensor * gt = r16(build_lora_mm_id(layer.ffn_gate_exps, y3, sel));
+            ggml_tensor * act = lut_silu ? ggml_mul(ctx0, lut_apply(gt, lut_silu), up) :
+                                ane_silu ? ggml_mul(ctx0, silu_ane(gt), up) : ggml_swiglu_split(ctx0, gt, up);
+            ggml_tensor * ex  = r16(build_lora_mm_id(layer.ffn_down_exps, r16(act), sel)); // [n_embd, n_used, n_tok]
+            cb(ex, "ffn_moe_down", il);
+
+            // unweighted sum over the selected experts: [n_embd, n_used, n_tok] -> [n_embd, n_tok]
+            ggml_tensor * moe = ggml_sum_rows(ctx0, ggml_cont(ctx0, ggml_permute(ctx0, ex, 1, 0, 2, 3)));
+            moe = ggml_reshape_2d(ctx0, moe, n_embd, n_tok);
+            cb(moe, "ffn_moe_out", il);
+            f = no_routed ? shared : (no_shexp ? moe : ggml_add(ctx0, moe, shared));
+        }
+        f = build_norm(f, layer.ffn_post_norm, NULL, LLM_NORM_RMS, il);
+        if (f16_act >= 3) { f = f16r(f); }
+        h = ggml_add(ctx0, y, f);
+        if (f16_act >= 1) { h = f16r(h); }
+        h = build_cvec(h, il);
+        cb(h, "l_out", il);
+    }
+
+    ggml_tensor * cur = build_norm(h,   model.output_norm,   NULL, LLM_NORM_RMS, -1);
+    cur               = build_norm(cur, model.output_norm_2, NULL, LLM_NORM_RMS, -1);
+    cb(cur, "result_norm", -1);
+    res->t_embd = cur;
+
+    cur = build_lora_mm(model.output, cur);
+    cb(cur, "result_output", -1);
+    res->t_logits = cur;
+
+    ggml_build_forward_expand(gf, cur);
+}
