diff --git a/tools/mtmd/models/afm.cpp b/tools/mtmd/models/afm.cpp
new file mode 100644
index 000000000..1a60e459e
--- /dev/null
+++ b/tools/mtmd/models/afm.cpp
@@ -0,0 +1,105 @@
+#include "models.h"
+
+// Apple Foundation Model image encoder (afmplus-v11.2 ImageTokenizer, converted by afm2gguf --vision).
+// ViT: patch embedding 14x14 (no bias) + learned 16x16 position table (bicubic-resized), pre RMSNorm, 24 blocks of
+// [RMSNorm -> q/k/v (bias) -> 2D RoPE (y on the first 16 rotation pairs, x on the last 16) -> per-head q/k RMSNorm ->
+// attention inside 12x12-patch windows (full attention on the layers listed in wa_layer_indexes) -> out (bias)] +
+// [RMSNorm -> SwiGLU 2816], final RMSNorm, then a 3x3 patch merger: Linear 9216->4096, LayerNorm, GELU, 4096->2048->1536.
+// Tokens are processed in Apple's order: window-major, 3x3 merge groups contiguous (inputs "afm_idx", "afm_pos",
+// "afm_mask" are filled by clip.cpp), so the merger concatenates 9 consecutive tokens and the output stays in that order.
+ggml_cgraph * clip_graph_afm::build() {
+    const int n_pos   = n_patches;
+    const int n_merge = hparams.n_merge;                 // 3
+    GGML_ASSERT(n_pos % (n_merge * n_merge) == 0);
+
+    ggml_tensor * inp_raw = build_inp_raw();
+    ggml_tensor * inp = ggml_conv_2d(ctx0, model.patch_embeddings_0, inp_raw, patch_size, patch_size, 0, 0, 1, 1);
+    inp = ggml_reshape_2d(ctx0, inp, n_pos, n_embd);
+    inp = ggml_cont(ctx0, ggml_transpose(ctx0, inp));    // [n_embd, n_pos], raster order
+    inp = ggml_add(ctx0, inp, resize_position_embeddings(GGML_SCALE_MODE_BICUBIC));
+    cb(inp, "patch_pos", -1);
+
+    ggml_tensor * idx = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, n_pos);
+    ggml_set_name(idx, "afm_idx");
+    ggml_set_input(idx);
+    ggml_tensor * positions = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, n_pos * 4);
+    ggml_set_name(positions, "afm_pos");
+    ggml_set_input(positions);
+    ggml_tensor * window_mask = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, n_pos, n_pos);
+    ggml_set_name(window_mask, "afm_mask");
+    ggml_set_input(window_mask);
+    ggml_tensor * mask = window_mask;
+    if (flash_attn_type == CLIP_FLASH_ATTN_TYPE_ENABLED) {
+        mask = ggml_cast(ctx0, window_mask, GGML_TYPE_F16);
+    }
+
+    ggml_tensor * inpL = ggml_get_rows(ctx0, inp, idx);  // -> Apple's token order
+    inpL = build_norm(inpL, model.pre_ln_w, nullptr, NORM_TYPE_RMS, eps, -1);
+
+    int sections[4] = {d_head / 4, d_head / 4, 0, 0};    // 16 rotation pairs for y, 16 for x
+    // Apple's Neural Engine activations: piecewise-linear tables. y = v[i] + d[i]*frac on a grid of n points from lo
+    // (step), constant below the grid, slope 1 above it; rounded to fp16. AFM_EXACT_ACT=1 uses the exact functions.
+    const bool ane_act = model.afm_silu_v && model.afm_silu_d && model.afm_gelu_v && model.afm_gelu_d && !getenv("AFM_EXACT_ACT");
+    auto pwl = [&](ggml_tensor * t, ggml_tensor * v, ggml_tensor * d, float lo, float step) -> ggml_tensor * {
+        const float n = (float) v->ne[1];
+        ggml_tensor * x  = ggml_cont(ctx0, t);
+        ggml_tensor * x1 = ggml_reshape_1d(ctx0, x, ggml_nelements(x));
+        ggml_tensor * u  = ggml_clamp(ctx0, ggml_scale_bias(ctx0, x1, 1.0f / step, -lo / step), 0.0f, n - 0.001f);
+        ggml_tensor * fl = ggml_scale_bias(ctx0, ggml_scale_bias(ctx0, ggml_scale_bias(ctx0, u, 1.0f, -0.5f), 1.0f, 12582912.0f), 1.0f, -12582912.0f);
+        fl = ggml_clamp(ctx0, fl, 0.0f, n - 1.0f);
+        ggml_tensor * fr = ggml_sub(ctx0, u, fl);
+        ggml_tensor * ix = ggml_cast(ctx0, fl, GGML_TYPE_I32);
+        ggml_tensor * vv = ggml_reshape_1d(ctx0, ggml_get_rows(ctx0, v, ix), ggml_nelements(x));
+        ggml_tensor * dd = ggml_reshape_1d(ctx0, ggml_get_rows(ctx0, d, ix), ggml_nelements(x));
+        ggml_tensor * y  = ggml_add(ctx0, ggml_add(ctx0, vv, ggml_mul(ctx0, dd, fr)), ggml_relu(ctx0, ggml_scale_bias(ctx0, x1, 1.0f, -(lo + n * step))));
+        y = ggml_cast(ctx0, ggml_cast(ctx0, y, GGML_TYPE_F16), GGML_TYPE_F32);
+        return ggml_reshape(ctx0, y, x);
+    };
+    for (int il = 0; il < n_layer; il++) {
+        const auto & layer = model.layers[il];
+        const bool full_attn = hparams.wa_layer_indexes.count(il) > 0;
+
+        ggml_tensor * cur = build_norm(inpL, layer.ln_1_w, nullptr, NORM_TYPE_RMS, eps, il);
+        ggml_tensor * Q = ggml_add(ctx0, ggml_mul_mat(ctx0, layer.q_w, cur), layer.q_b);
+        ggml_tensor * K = ggml_add(ctx0, ggml_mul_mat(ctx0, layer.k_w, cur), layer.k_b);
+        ggml_tensor * V = ggml_add(ctx0, ggml_mul_mat(ctx0, layer.v_w, cur), layer.v_b);
+        Q = ggml_reshape_3d(ctx0, Q, d_head, n_head, n_pos);
+        K = ggml_reshape_3d(ctx0, K, d_head, n_head, n_pos);
+        V = ggml_reshape_3d(ctx0, V, d_head, n_head, n_pos);
+        // RoPE first, then the per-head RMSNorm with its gain (the converter permuted head dims to half-split pairs)
+        Q = ggml_rope_multi(ctx0, Q, positions, nullptr, d_head / 2, sections, GGML_ROPE_TYPE_VISION, 32768, hparams.rope_theta, 1, 0, 1, 32, 1);
+        K = ggml_rope_multi(ctx0, K, positions, nullptr, d_head / 2, sections, GGML_ROPE_TYPE_VISION, 32768, hparams.rope_theta, 1, 0, 1, 32, 1);
+        Q = build_norm(Q, layer.q_norm, nullptr, NORM_TYPE_RMS, eps, il);
+        K = build_norm(K, layer.k_norm, nullptr, NORM_TYPE_RMS, eps, il);
+        cb(Q, "Qcur", il);
+        cb(K, "Kcur", il);
+
+        cur = build_attn(layer.o_w, layer.o_b, Q, K, V, full_attn ? nullptr : mask, kq_scale, il);
+        cb(cur, "attn_out", il);
+        inpL = ggml_add(ctx0, cur, inpL);
+
+        cur = build_norm(inpL, layer.ln_2_w, nullptr, NORM_TYPE_RMS, eps, il);
+        if (ane_act) {
+            ggml_tensor * g = ggml_mul_mat(ctx0, layer.ff_gate_w, cur);
+            ggml_tensor * u = ggml_mul_mat(ctx0, layer.ff_up_w, cur);
+            cur = ggml_mul_mat(ctx0, layer.ff_down_w, ggml_mul(ctx0, pwl(g, model.afm_silu_v, model.afm_silu_d, -10.5f, 0.5f), u));
+        } else {
+            cur = build_ffn(cur, layer.ff_up_w, nullptr, layer.ff_gate_w, nullptr, layer.ff_down_w, nullptr, FFN_SILU, il);
+        }
+        cb(cur, "ffn_out", il);
+        inpL = ggml_add(ctx0, inpL, cur);
+        cb(inpL, "layer_out", il);
+    }
+
+    ggml_tensor * cur = build_norm(inpL, model.post_ln_w, nullptr, NORM_TYPE_RMS, eps, n_layer);
+    cur = ggml_reshape_2d(ctx0, cur, n_embd * n_merge * n_merge, n_pos / (n_merge * n_merge));
+    cur = ggml_mul_mat(ctx0, model.mm_0_w, cur);
+    cur = build_norm(cur, model.mm_post_norm_w, model.mm_post_norm_b, NORM_TYPE_NORMAL, 1e-6f, -1);
+    cur = ane_act ? pwl(cur, model.afm_gelu_v, model.afm_gelu_d, -4.0f, 0.25f) : ggml_gelu_erf(ctx0, cur);
+    cur = ggml_mul_mat(ctx0, model.mm_1_w, cur);
+    cur = ggml_mul_mat(ctx0, model.mm_2_w, cur);
+    cb(cur, "afm_embd", -1);
+
+    ggml_build_forward_expand(gf, cur);
+    return gf;
+}
