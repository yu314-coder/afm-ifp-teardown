+static float afm_env_f(const char * k, float d) { const char * v = getenv(k); return v ? (float) atof(v) : d; }
+
+// Per-ubatch indices for Apple's IFP expert schedule (TokenGenerationInference.IFPExpertPicker):
+//  - a run of >1 tokens of one sequence is a prompt chunk: all of its tokens use the router logits of the chunk's LAST
+//    token, which become the sequence's persisted choice;
+//  - a single decode token re-picks from its own logits when pos % freq == 0, otherwise reuses the persisted choice.
+class llm_graph_input_afm_route : public llm_graph_input_i {
+public:
+    llm_graph_input_afm_route(int64_t n_slots, int64_t freq, bool prompt_own) : n_slots(n_slots), freq(freq), prompt_own(prompt_own) {}
+    void set_input(const llama_ubatch * ub) override {
+        const int64_t T = ub->n_tokens;
+        std::vector<int32_t> ist(T), itk(T); std::vector<int64_t> idst(T); std::vector<float> use(T);
+        std::vector<std::pair<llama_seq_id, std::pair<int64_t, int64_t>>> runs;   // seq -> (count, last index)
+        auto run = [&](llama_seq_id s) -> std::pair<int64_t, int64_t> & {
+            for (auto & r : runs) { if (r.first == s) { return r.second; } }
+            runs.push_back({s, {0, 0}}); return runs.back().second; };
+        for (int64_t i = 0; i < T; ++i) { auto & r = run(ub->seq_id[i][0]); r.first++; r.second = i; }
+        for (int64_t i = 0; i < T; ++i) {
+            const llama_seq_id s = ub->seq_id[i][0];
+            const int64_t slot = ((s % n_slots) + n_slots) % n_slots;
+            const auto & r = run(s);
+            ist[i] = (int32_t) slot; itk[i] = (int32_t) i; idst[i] = n_slots; use[i] = 1.0f;     // n_slots = discard slot
+            if (r.first > 1) {
+                if (!prompt_own) { itk[i] = (int32_t) r.second; }
+                if (i == r.second) { idst[i] = slot; }
+            } else if (ub->pos[i] % freq == 0) {
+                idst[i] = slot;
+            } else {
+                use[i] = 0.0f;
+            }
+        }
+        ggml_backend_tensor_set(src_state, ist.data(), 0, T*sizeof(int32_t));
+        ggml_backend_tensor_set(src_tok,   itk.data(), 0, T*sizeof(int32_t));
+        ggml_backend_tensor_set(dst,       idst.data(), 0, T*sizeof(int64_t));
+        ggml_backend_tensor_set(use_tok,   use.data(), 0, T*sizeof(float));
+    }
+    bool can_reuse(const llm_graph_params & params) override { return src_tok->ne[0] == (int64_t) params.ubatch.n_tokens; }
+    ggml_tensor * src_state = nullptr; // I32 [T]   persisted slot to read
+    ggml_tensor * src_tok   = nullptr; // I32 [T]   in-batch token whose fresh logits to read
+    ggml_tensor * dst       = nullptr; // I64 [T]   slot to write this token's fresh logits to (n_slots = discard)
+    ggml_tensor * use_tok   = nullptr; // F32 [1,T] 1 = fresh logits, 0 = persisted
+    const int64_t n_slots, freq;
+    const bool    prompt_own;   // prompt-chunk tokens route on their own logits (the pick for generation is unchanged)
+};
+
+// Apple runs prompt chunks through the prompt_opt procedures, whose layer-0 constant is zero, and generated tokens through
+// the extend procedures, which add the input bias. 1 = this token gets the bias: a lone token of its sequence in the
+// ubatch (a decode step); 0 = part of a multi-token run of one sequence (a prompt chunk).
+class llm_graph_input_afm_bias_mask : public llm_graph_input_i {
+public:
+    explicit llm_graph_input_afm_bias_mask(int64_t freq) : freq(freq) {}
+    void set_input(const llama_ubatch * ub) override {
+        const int64_t T = ub->n_tokens;
+        std::vector<float> m(T);
+        for (int64_t i = 0; i < T; ++i) {
+            int64_t cnt = 0;
+            for (int64_t j = 0; j < T; ++j) { cnt += ub->seq_id[j][0] == ub->seq_id[i][0]; }
+            // a re-pick token (position a multiple of the selection frequency) runs Apple's dense-only function: no bias
+            m[i] = (cnt == 1 && (freq <= 0 || ub->pos[i] % freq != 0)) ? 1.0f : 0.0f;
+        }
+        ggml_backend_tensor_set(t, m.data(), 0, T*sizeof(float));
+    }
+    bool can_reuse(const llm_graph_params & params) override { return t->ne[1] == (int64_t) params.ubatch.n_tokens; }
+    ggml_tensor * t = nullptr;   // F32 [1, T]
+    const int64_t freq;
+};
+
+// research: Neural Engine elementwise functions as exact lookup tables. AFM_ANE_SILU=<file> holds 65536 fp16 outputs
+// indexed by the fp16 bit pattern of the input (tabulated on the ANE through CoreML); the input is rounded to fp16
+// first, as on the ANE. CPU custom op (the scheduler runs it on the CPU backend).
+static const uint16_t * afm_load_lut(const char * env) {
+    static std::vector<std::pair<std::string, std::vector<uint16_t>>> cache;
+    const char * path = getenv(env);
+    if (!path) { return nullptr; }
+    for (auto & c : cache) { if (c.first == path) { return c.second.data(); } }
+    std::vector<uint16_t> t(65536);
+    FILE * f = fopen(path, "rb");
+    if (!f || fread(t.data(), 2, 65536, f) != 65536) { fprintf(stderr, "%s: cannot read 65536 fp16 from %s\n", env, path); if (f) fclose(f); return nullptr; }
+    fclose(f); cache.push_back({path, std::move(t)}); return cache.back().second.data();
+}
+static void afm_lut_op(ggml_tensor * dst, const ggml_tensor * a, int ith, int nth, void * ud) {
+    const uint16_t * tab = (const uint16_t *) ud;
+    const int64_t n = ggml_nelements(dst), per = (n + nth - 1) / nth, i0 = per * ith, i1 = std::min<int64_t>(n, i0 + per);
+    const float * x = (const float *) a->data; float * y = (float *) dst->data;
+    for (int64_t i = i0; i < i1; ++i) { y[i] = ggml_fp16_to_fp32((ggml_fp16_t) tab[(uint16_t) ggml_fp32_to_fp16(x[i])]); }
+}
+
+// research: AFM_ROUTE_FORCE=<file> replaces the router logits of a batch with float32 [T, n_expert * n_sparse_layers]
+// read from the file (row t = token t); only the top-k selection matters, the routed experts are summed unweighted
+class llm_graph_input_afm_force : public llm_graph_input_i {
+public:
+    explicit llm_graph_input_afm_force(const char * path) : path(path) {}
+    void set_input(const llama_ubatch *) override {
+        std::vector<float> buf(ggml_nelements(t), 0.0f);
+        if (FILE * f = fopen(path.c_str(), "rb")) {
+            const size_t n = fread(buf.data(), sizeof(float), buf.size(), f); fclose(f);
+            if (n != buf.size()) { fprintf(stderr, "AFM_ROUTE_FORCE: %s has %zu of %zu floats\n", path.c_str(), n, buf.size()); }
+        } else { fprintf(stderr, "AFM_ROUTE_FORCE: cannot read %s\n", path.c_str()); }
+        ggml_backend_tensor_set(t, buf.data(), 0, ggml_nbytes(t));
+    }
+    bool can_reuse(const llm_graph_params &) override { return false; }
+    ggml_tensor * t = nullptr;
+    std::string path;
+};
+
+// Apple Foundation Model, on-device "afmplus-v11.2-ifp" (3B, Instruction-Following-Pruned sparse FFN).
+//
+//   L0:   x = embd (+ inp_bias on generated tokens only; prompt chunks and re-pick tokens add nothing, as in Apple's
+//         prompt_opt and dense-only re-pick procedures)
+//         embd = int4 code * per-token scale; no multiplier, no norm on the first layer input
+//   L>0:  x = rms(h) * layer_out_norm[L-1]
+//         h'  = x + rms(attn(x)) * attn_post_norm                   (post-LN "x/y" residual: residual is the
+//         y   = rms(h') * ffn_norm                                    normalised stream, not raw h)
+//         h   = y + rms(ffn(y)) * ffn_post_norm
+//   attn: q = rms(rope_neox(Wq x)) * q_norm ; k likewise (k_norm optional) ; GQA ; layers >= kv_reuse_first
+//         reuse the K/V cache of the last KV-owning layer
+//   ffn:  dense SwiGLU for the first n_layer_dense_lead layers; afterwards an UNWEIGHTED sum of a shared SwiGLU
+//         (the always-on experts) and n_expert_used routed SwiGLU experts. The routing logits for all sparse layers
+//         come from one small router network evaluated on the layer-n_layer_dense_lead input x.
+//   routing schedule (Apple's IFPExpertPicker): the router runs on ONE token, not per token -- the last token of
+//         the prompt picks the experts for every prompt token and for generation, and a decode token re-picks only
+//         when its position is a multiple of 32. The choice persists per sequence in model.afm_route_state.
+//   out:  logits = (rms(rms(h) * output_norm) * output_norm_2) @ tok_embd^T
+llm_build_afm::llm_build_afm(const llama_model & model, const llm_graph_params & params) : llm_graph_context(params) {
+    const int64_t n_embd_head = hparams.n_embd_head_k;
+    const int     n_dense     = (int) hparams.n_layer_dense_lead;
+
+    ggml_tensor * inpL = build_inp_embd(model.tok_embd);
+    // research knobs (unset = model defaults): AFM_KSCALE, AFM_NO_SHEXP, AFM_NO_ROUTED, AFM_NUSED, AFM_KVQ=0,
+    // AFM_ROUTE_POOL/_START/_MODE (pool router input over a token range), AFM_ROUTE_CUM (causal prefix-mean routing)
+    const float kscale    = afm_env_f("AFM_KSCALE", 1.0f);   // research multiplier; Apple applies none
+    const bool  no_shexp  = afm_env_f("AFM_NO_SHEXP", 0) != 0;
+    const bool  no_routed = afm_env_f("AFM_NO_ROUTED", 0) != 0;
+    // IFP configuration (Apple config.json): ifp1/ifp2/ifp3 = 5/14/23 always-on experts (a prefix of the 23 stored) plus as
+    // many routed experts. The base model and the FM API use ifp3; feature adapters declare their own (lora_i1/i2/i3).
+    // the active feature adapter (an AFM LoRA written by afm2gguf --adapter) declares its IFP level in adapter.afm.ifp
+    int ifp_from_adapter = 0;
+    if (loras) {
+        for (const auto & [ad, sc] : *loras) {
+            if (sc == 0.0f) { continue; }
+            auto it = ad->gguf_kv.find("adapter.afm.ifp");
+            if (it != ad->gguf_kv.end()) { ifp_from_adapter = std::max(ifp_from_adapter, atoi(it->second.c_str())); }
+        }
+    }
+    const int   ifp       = (int) afm_env_f("AFM_IFP", ifp_from_adapter ? (float) ifp_from_adapter : 3.0f);
+    const int   n_static  = ifp == 1 ? 5 : ifp == 2 ? 14 : (int) (hparams.n_ff_shexp / hparams.n_ff_exp);
+    const int   n_used    = (int) afm_env_f("AFM_NUSED", ifp == 1 ? 5.0f : ifp == 2 ? 14.0f : (float) n_expert_used);
+    const bool  kvq       = afm_env_f("AFM_KVQ", 1) != 0; // default on when the GGUF carries scales
+    const int   pool_n    = (int) afm_env_f("AFM_ROUTE_POOL", 0);
+    const int   pool_s    = (int) afm_env_f("AFM_ROUTE_POOL_START", 0);
+    const int   pool_mode = (int) afm_env_f("AFM_ROUTE_POOL_MODE", 0); // 0 mean input, 1 mean logits, 2 mean sigmoid, 3 vote
+    const int   vote_k    = (int) afm_env_f("AFM_ROUTE_VOTE_K", 32);     // mode 3: each pooled token votes for its top-k experts
+    const bool  hybrid    = afm_env_f("AFM_ROUTE_HYBRID", 0) != 0;      // pooled experts for tokens < pool_n, per-token after
+    // Apple's schedule (TokenGenerationInference IFPExpertPicker): experts for the whole prompt come from the router on the
+    // LAST prompt token; during generation they are re-picked from the current token at absolute positions p % FREQ == 0.
+    // AFM_ROUTE_SCHED=<prompt length> applies it to a teacher-forced batch that starts at position 0.
+    const int   sched_p   = (int) afm_env_f("AFM_ROUTE_SCHED", 0);
+    const int   sched_f   = (int) afm_env_f("AFM_ROUTE_FREQ", 32);
+    const int   sched_lag = (int) afm_env_f("AFM_ROUTE_SCHED_LAG", 0);   // 1: a boundary pick takes effect one token later
+    const bool  route_at_ffn = afm_env_f("AFM_ROUTE_AT_FFN", 0) != 0;      // research: router input = layer-12 FFN input
+    const bool  prompt_own   = afm_env_f("AFM_ROUTE_PROMPT_OWN", 0) != 0;  // prompt tokens per-token; generation keeps Apple's pick
+    const float attn_scale   = hparams.f_attention_scale * afm_env_f("AFM_ATTN_SCALE_MUL", 1.0f);   // research multiplier
+    const int   f16_act      = (int) afm_env_f("AFM_F16_ACT", 0);          // research: round activations to fp16 (1: residual, 2: +router input, 3: +attn/ffn outputs)
+    auto f16r = [&](ggml_tensor * t) { return ggml_cast(ctx0, ggml_cast(ctx0, t, GGML_TYPE_F16), GGML_TYPE_F32); };
+    const bool mm16 = afm_env_f("AFM_MM_F16", 0) != 0;   // research: round every matmul / attention output to fp16 (as the ANE stores them)
+    auto r16 = [&](ggml_tensor * t) { return mm16 ? f16r(t) : t; };
+    // emulate the ANE int8 KV cache: x -> clamp(round(x*s), -127, 127) / s
+    const int kvq_mode = (int) afm_env_f("AFM_KVQ_MODE", 0);   // research: 0 round-half-even, 1 truncate toward zero
+    auto fq8 = [&](ggml_tensor * t, float s) {
+        if (kvq_mode == 1) {   // trunc(x*s) = sign(x)*floor(|x*s|), floor(a) = round(a - 0.5) for a >= 0 (ties do not matter here)
+            ggml_tensor * a  = ggml_abs(ctx0, ggml_scale(ctx0, t, s));
+            ggml_tensor * fl = ggml_scale_bias(ctx0, ggml_scale_bias(ctx0, ggml_scale_bias(ctx0, a, 1.0f, -0.4999f), 1.0f, 12582912.0f), 1.0f, -12582912.0f);
+            return ggml_scale(ctx0, ggml_mul(ctx0, ggml_clamp(ctx0, fl, 0.0f, 127.0f), ggml_sgn(ctx0, t)), 1.0f/s);
+        }
+        // round-to-nearest via the fp32 magic constant 1.5*2^23 (backend-independent), saturate to int8, rescale
+        ggml_tensor * r = ggml_scale_bias(ctx0, t, s, 12582912.0f);
+        r = ggml_scale_bias(ctx0, r, 1.0f, -12582912.0f);
+        return ggml_scale(ctx0, ggml_clamp(ctx0, r, -127.0f, 127.0f), 1.0f/s); };
+    const bool  route_cum = afm_env_f("AFM_ROUTE_CUM", 0) != 0;
+    const bool  gamma_first = afm_env_f("AFM_QK_GAMMA_FIRST", 0) != 0;   // research: q/k gain before RoPE
+    const uint16_t * lut_silu = afm_load_lut("AFM_ANE_SILU");          // research: ANE SiLU table for the FFNs
+    const uint16_t * lut_silu_r = afm_load_lut("AFM_ANE_SILU_ROUTER"); // research: ANE SiLU table for the router
+    auto lut_apply = [&](ggml_tensor * t, const uint16_t * tab) {
+        return ggml_map_custom1(ctx0, ggml_cont(ctx0, t), afm_lut_op, GGML_N_TASKS_MAX, (void *) tab); };
+    auto ffn_lut = [&](ggml_tensor * yy, ggml_tensor * wu, ggml_tensor * wg, ggml_tensor * wd) {
+        ggml_tensor * u = build_lora_mm(wu, yy), * g = build_lora_mm(wg, yy);
+        return build_lora_mm(wd, ggml_mul(ctx0, lut_apply(g, lut_silu), u)); };
