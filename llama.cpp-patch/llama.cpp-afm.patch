+#include "models.h"
+
+#include <algorithm>
+#include <cstdlib>
+#include <cmath>
+
+static float afm_env_f(const char * k, float d) { const char * v = getenv(k); return v ? (float) atof(v) : d; }
+
+// Per-ubatch indices for Apple's IFP expert schedule (TokenGenerationInference.IFPExpertPicker):
+//  - a run of >1 tokens of one sequence is a prompt chunk: all of its tokens use the router logits of the chunk's LAST
+//    token, which become the sequence's persisted choice;
+//  - a single decode token re-picks from its own logits when pos % freq == 0, otherwise reuses the persisted choice.
+class llm_graph_input_afm_route : public llm_graph_input_i {
+public:
+    llm_graph_input_afm_route(int64_t n_slots, int64_t freq, bool prompt_own) : n_slots(n_slots), freq(freq), prompt_own(prompt_own) {}
+    void set_input(const llama_ubatch * ub) override {
+        const int64_t T = ub->n_tokens;
+        std::vector<int32_t> ist(T), itk(T); std::vector<int64_t> idst(T); std::vector<float> use(T);
+        std::vector<std::pair<llama_seq_id, std::pair<int64_t, int64_t>>> runs;   // seq -> (count, last index)
+        auto run = [&](llama_seq_id s) -> std::pair<int64_t, int64_t> & {
+            for (auto & r : runs) { if (r.first == s) { return r.second; } }
+            runs.push_back({s, {0, 0}}); return runs.back().second; };
+        for (int64_t i = 0; i < T; ++i) { auto & r = run(ub->seq_id[i][0]); r.first++; r.second = i; }
+        for (int64_t i = 0; i < T; ++i) {
+            const llama_seq_id s = ub->seq_id[i][0];
+            const int64_t slot = ((s % n_slots) + n_slots) % n_slots;
+            const auto & r = run(s);
+            ist[i] = (int32_t) slot; itk[i] = (int32_t) i; idst[i] = n_slots; use[i] = 1.0f;     // n_slots = discard slot
+            if (r.first > 1) {
+                if (!prompt_own) { itk[i] = (int32_t) r.second; }
+                if (i == r.second) { idst[i] = slot; }
+            } else if (ub->pos[i] % freq == 0) {
+                idst[i] = slot;
+            } else {
+                use[i] = 0.0f;
+            }
+        }
+        ggml_backend_tensor_set(src_state, ist.data(), 0, T*sizeof(int32_t));
+        ggml_backend_tensor_set(src_tok,   itk.data(), 0, T*sizeof(int32_t));
+        ggml_backend_tensor_set(dst,       idst.data(), 0, T*sizeof(int64_t));
+        ggml_backend_tensor_set(use_tok,   use.data(), 0, T*sizeof(float));
+    }
+    bool can_reuse(const llm_graph_params & params) override { return src_tok->ne[0] == (int64_t) params.ubatch.n_tokens; }
+    ggml_tensor * src_state = nullptr; // I32 [T]   persisted slot to read
+    ggml_tensor * src_tok   = nullptr; // I32 [T]   in-batch token whose fresh logits to read
+    ggml_tensor * dst       = nullptr; // I64 [T]   slot to write this token's fresh logits to (n_slots = discard)
+    ggml_tensor * use_tok   = nullptr; // F32 [1,T] 1 = fresh logits, 0 = persisted
+    const int64_t n_slots, freq;
+    const bool    prompt_own;   // prompt-chunk tokens route on their own logits (the pick for generation is unchanged)
+};
+
+// Apple Foundation Model, on-device "afmplus-v11.2-ifp" (3B, Instruction-Following-Pruned sparse FFN).
+//
+//   L0:   x = k * embd + inp_bias                                   (no norm on the first layer input)
+//   L>0:  x = rms(h) * layer_out_norm[L-1]
+//         h'  = x + rms(attn(x)) * attn_post_norm                   (post-LN "x/y" residual: residual is the
+//         y   = rms(h') * ffn_norm                                    normalised stream, not raw h)
+//         h   = y + rms(ffn(y)) * ffn_post_norm
+//   attn: q = rms(rope_neox(Wq x)) * q_norm ; k likewise (k_norm optional) ; GQA ; layers >= kv_reuse_first
+//         reuse the K/V cache of the last KV-owning layer
+//   ffn:  dense SwiGLU for the first n_layer_dense_lead layers; afterwards an UNWEIGHTED sum of a shared SwiGLU
+//         (the always-on experts) and n_expert_used routed SwiGLU experts. The routing logits for all sparse layers
+//         come from one small router network evaluated on the layer-n_layer_dense_lead input x.
+//   routing schedule (Apple's IFPExpertPicker): the router runs on ONE token, not per token -- the last token of
+//         the prompt picks the experts for every prompt token and for generation, and a decode token re-picks only
+//         when its position is a multiple of 32. The choice persists per sequence in model.afm_route_state.
+//   out:  logits = (rms(rms(h) * output_norm) * output_norm_2) @ tok_embd^T
+llm_build_afm::llm_build_afm(const llama_model & model, const llm_graph_params & params) : llm_graph_context(params) {
+    const int64_t n_embd_head = hparams.n_embd_head_k;
+    const int     n_dense     = (int) hparams.n_layer_dense_lead;
+
+    ggml_tensor * inpL = build_inp_embd(model.tok_embd);
+    // research knobs (unset = model defaults): AFM_KSCALE, AFM_NO_SHEXP, AFM_NO_ROUTED, AFM_NUSED, AFM_KVQ=0,
+    // AFM_ROUTE_POOL/_START/_MODE (pool router input over a token range), AFM_ROUTE_CUM (causal prefix-mean routing)
+    const float kscale    = afm_env_f("AFM_KSCALE", hparams.f_embedding_scale);
+    const bool  no_shexp  = afm_env_f("AFM_NO_SHEXP", 0) != 0;
+    const bool  no_routed = afm_env_f("AFM_NO_ROUTED", 0) != 0;
+    const int   n_used    = (int) afm_env_f("AFM_NUSED", (float) n_expert_used);
+    const bool  kvq       = afm_env_f("AFM_KVQ", 1) != 0; // default on when the GGUF carries scales
+    const int   pool_n    = (int) afm_env_f("AFM_ROUTE_POOL", 0);
+    const int   pool_s    = (int) afm_env_f("AFM_ROUTE_POOL_START", 0);
+    const int   pool_mode = (int) afm_env_f("AFM_ROUTE_POOL_MODE", 0); // 0 mean input, 1 mean logits, 2 mean sigmoid, 3 vote
+    const int   vote_k    = (int) afm_env_f("AFM_ROUTE_VOTE_K", 32);     // mode 3: each pooled token votes for its top-k experts
+    const bool  hybrid    = afm_env_f("AFM_ROUTE_HYBRID", 0) != 0;      // pooled experts for tokens < pool_n, per-token after
+    // Apple's schedule (TokenGenerationInference IFPExpertPicker): experts for the whole prompt come from the router on the
+    // LAST prompt token; during generation they are re-picked from the current token at absolute positions p % FREQ == 0.
+    // AFM_ROUTE_SCHED=<prompt length> applies it to a teacher-forced batch that starts at position 0.
+    const int   sched_p   = (int) afm_env_f("AFM_ROUTE_SCHED", 0);
+    const int   sched_f   = (int) afm_env_f("AFM_ROUTE_FREQ", 32);
+    const int   sched_lag = (int) afm_env_f("AFM_ROUTE_SCHED_LAG", 0);   // 1: a boundary pick takes effect one token later
+    const bool  route_at_ffn = afm_env_f("AFM_ROUTE_AT_FFN", 0) != 0;      // research: router input = layer-12 FFN input
+    const bool  prompt_own   = afm_env_f("AFM_ROUTE_PROMPT_OWN", 0) != 0;  // prompt tokens per-token; generation keeps Apple's pick
+    const float attn_scale   = hparams.f_attention_scale * afm_env_f("AFM_ATTN_SCALE_MUL", 1.0f);   // research multiplier
+    const int   f16_act      = (int) afm_env_f("AFM_F16_ACT", 0);          // research: round activations to fp16 (1: residual, 2: +router input, 3: +attn/ffn outputs)
+    auto f16r = [&](ggml_tensor * t) { return ggml_cast(ctx0, ggml_cast(ctx0, t, GGML_TYPE_F16), GGML_TYPE_F32); };
+    // emulate the ANE int8 KV cache: x -> clamp(round(x*s), -127, 127) / s
+    auto fq8 = [&](ggml_tensor * t, float s) {
+        // round-to-nearest via the fp32 magic constant 1.5*2^23 (backend-independent), saturate to int8, rescale
+        ggml_tensor * r = ggml_scale_bias(ctx0, t, s, 12582912.0f);
+        r = ggml_scale_bias(ctx0, r, 1.0f, -12582912.0f);
+        return ggml_scale(ctx0, ggml_clamp(ctx0, r, -127.0f, 127.0f), 1.0f/s); };
+    const bool  route_cum = afm_env_f("AFM_ROUTE_CUM", 0) != 0;
+    if (ubatch.token) {
+        inpL = ggml_scale(ctx0, inpL, kscale);
+    }
+    inpL = ggml_add(ctx0, inpL, model.inp_bias);
+    cb(inpL, "inp_scaled", -1);
+
+    ggml_tensor * inp_pos     = build_inp_pos();
+    auto        * inp_attn    = build_attn_inp_kv();
+    ggml_tensor * inp_out_ids = build_inp_out_ids();
+
+    // research (teacher-forced batches starting at position 0 only): AFM_ROPE_F16=1 computes the RoPE angles the way an
+    // fp16 pipeline would (fp16 position x fp16 inverse frequency, rounded to fp16); 2 also rounds cos/sin to fp16;
+    // 9 = the same custom path in fp32 (must equal ggml_rope_ext)
+    const int rope_f16 = (int) afm_env_f("AFM_ROPE_F16", 0);
+    ggml_tensor * rope_c = nullptr, * rope_s = nullptr;
+    if (rope_f16) {
+        const int64_t T = n_tokens, hd2 = n_rot/2;
+        auto rnd = [&](ggml_tensor * t) { return rope_f16 == 9 ? t : f16r(t); };
+        ggml_tensor * pp  = rnd(ggml_arange(ctx0, 0.0f, (float) T, 1.0f));
+        ggml_tensor * inv = rnd(ggml_exp(ctx0, ggml_scale(ctx0, ggml_arange(ctx0, 0.0f, (float) hd2, 1.0f), -2.0f*logf(freq_base)/n_rot)));
+        ggml_tensor * tm  = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, hd2, T);
+        ggml_tensor * th  = rnd(ggml_mul(ctx0, ggml_repeat(ctx0, ggml_reshape_2d(ctx0, inv, hd2, 1), tm),
+                                              ggml_repeat(ctx0, ggml_reshape_2d(ctx0, pp, 1, T), tm)));
+        rope_c = ggml_cos(ctx0, th); rope_s = ggml_sin(ctx0, th);
+        if (rope_f16 == 2) { rope_c = f16r(rope_c); rope_s = f16r(rope_s); }
+        rope_c = ggml_reshape_3d(ctx0, rope_c, hd2, 1, T); rope_s = ggml_reshape_3d(ctx0, rope_s, hd2, 1, T);
+        // keep inp_pos in the graph (it is still set every ubatch even though this path does not read it)
+        ggml_build_forward_expand(gf, ggml_rope_ext(ctx0, ggml_fill(ctx0, ggml_new_tensor_3d(ctx0, GGML_TYPE_F32, n_rot, 1, T), 0.0f),
+                                                    inp_pos, nullptr, n_rot, rope_type, n_ctx_orig, freq_base, freq_scale,
+                                                    ext_factor, attn_factor, beta_fast, beta_slow));
+    }
+    auto rope = [&](ggml_tensor * t) -> ggml_tensor * {
+        if (!rope_f16) {
+            return ggml_rope_ext(ctx0, t, inp_pos, nullptr, n_rot, rope_type, n_ctx_orig, freq_base, freq_scale,
+                                 ext_factor, attn_factor, beta_fast, beta_slow);
+        }
+        const int64_t hd2 = n_rot/2;   // NEOX: rotate (i, i + n_rot/2)
+        ggml_tensor * a = ggml_cont(ctx0, ggml_view_3d(ctx0, t, hd2, t->ne[1], t->ne[2], t->nb[1], t->nb[2], 0));
+        ggml_tensor * b = ggml_cont(ctx0, ggml_view_3d(ctx0, t, hd2, t->ne[1], t->ne[2], t->nb[1], t->nb[2], hd2*t->nb[0]));
+        ggml_tensor * o1 = ggml_sub(ctx0, ggml_mul(ctx0, a, rope_c), ggml_mul(ctx0, b, rope_s));
+        ggml_tensor * o2 = ggml_add(ctx0, ggml_mul(ctx0, b, rope_c), ggml_mul(ctx0, a, rope_s));
+        return ggml_concat(ctx0, o1, o2, 0);
+    };
+
+    ggml_tensor * h             = nullptr;
+    ggml_tensor * router_logits = nullptr; // [n_expert * n_sparse_layers, n_tokens]
+
+    for (int il = 0; il < n_layer; ++il) {
+        const auto & layer = model.layers[il];
+
+        ggml_tensor * x = il == 0 ? inpL : build_norm(h, model.layers[il - 1].layer_out_norm, NULL, LLM_NORM_RMS, il);
+        cb(x, "attn_in", il);
+
+        auto route_block = [&](ggml_tensor * x) {
+            if (f16_act >= 2) { x = f16r(x); }   // Apple's expert state is an fp16 tensor
+            ggml_tensor * r_in = x;
+            const int64_t p0 = std::min<int64_t>(pool_s, x->ne[1] - 1);
+            const int64_t np = std::max<int64_t>(1, std::min<int64_t>(pool_n, x->ne[1]) - p0);
+            if (pool_n > 0 && pool_mode == 0) {
+                ggml_tensor * xv = ggml_view_2d(ctx0, x, n_embd, np, x->nb[1], p0 * x->nb[1]);
+                r_in = ggml_reshape_2d(ctx0, ggml_mean(ctx0, ggml_cont(ctx0, ggml_transpose(ctx0, xv))), n_embd, 1);
+            }
+            if (route_cum && pool_n == 0) {
+                // causal prefix mean of the router input: r_t = mean_{s<=t} x_s
+                const int64_t T = x->ne[1];
+                ggml_tensor * tri = ggml_diag_mask_zero(ctx0, ggml_fill(ctx0, ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, T, T), 1.0f), 0);
+                tri = ggml_div(ctx0, tri, ggml_sum_rows(ctx0, tri));
+                r_in = ggml_mul_mat(ctx0, ggml_cont(ctx0, ggml_transpose(ctx0, x)), tri);
+            }
+            auto router_net = [&](ggml_tensor * in) {
+                ggml_tensor * r = build_lora_mm(layer.ifp_router_fc1, in);
+                r = ggml_add(ctx0, r, layer.ifp_router_fc1_b);
+                r = ggml_silu(ctx0, r);
+                r = build_norm(r, layer.ifp_router_norm, NULL, LLM_NORM_RMS, il);
+                r = build_lora_mm(layer.ifp_router_fc2, r);
+                return ggml_add(ctx0, r, layer.ifp_router_fc2_b);
+            };
+            router_logits = router_net(r_in);
+            ggml_tensor * per_tok = (r_in == x) ? router_logits : router_net(x);                    // [E*layers, T]
+            const bool apple_sched = model.afm_route_state && afm_env_f("AFM_ROUTE_TOKEN", 0) == 0 && pool_n == 0 && !route_cum;
+            if (apple_sched && sched_p == 0) {
+                auto inp = std::make_unique<llm_graph_input_afm_route>(model.afm_route_state->ne[1] - 1, std::max(1, sched_f), prompt_own);
+                const int64_t T = per_tok->ne[1];
+                inp->src_state = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, T); ggml_set_input(inp->src_state);
+                inp->src_tok   = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, T); ggml_set_input(inp->src_tok);
+                inp->dst       = ggml_new_tensor_1d(ctx0, GGML_TYPE_I64, T); ggml_set_input(inp->dst);
+                inp->use_tok   = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, 1, T); ggml_set_input(inp->use_tok);
+                ggml_tensor * fresh = ggml_get_rows(ctx0, per_tok, inp->src_tok);                       // [E*layers, T]
+                ggml_tensor * kept  = ggml_get_rows(ctx0, model.afm_route_state, inp->src_state);       // [E*layers, T]
+                router_logits = ggml_add(ctx0, kept, ggml_mul(ctx0, ggml_sub(ctx0, fresh, kept), inp->use_tok));
+                ggml_build_forward_expand(gf, ggml_set_rows(ctx0, model.afm_route_state, per_tok, inp->dst));
+                res->add_input(std::move(inp));
+            } else if (sched_p > 0) {
+                // src(t) = max(P-1, F*floor((t-lag)/F)); one-hot selection S[j,t] = [j == src(t)], logits = per_tok @ S
+                const int64_t T = x->ne[1];
+                ggml_tensor * t  = ggml_arange(ctx0, 0.0f, (float) T, 1.0f);                                   // [T]
+                ggml_tensor * fl = ggml_scale_bias(ctx0, t, 1.0f/sched_f, -(sched_lag + 0.5f*(sched_f - 1))/sched_f);
+                fl = ggml_scale_bias(ctx0, ggml_scale_bias(ctx0, fl, 1.0f, 12582912.0f), 1.0f, -12582912.0f); // round
+                ggml_tensor * src = ggml_clamp(ctx0, ggml_scale(ctx0, fl, (float) sched_f), (float) (sched_p - 1), 1e9f);
+                if (prompt_own) {   // m = 1 for t < P (t integer), src = m*t + (1-m)*src
+                    ggml_tensor * m = ggml_clamp(ctx0, ggml_scale_bias(ctx0, t, -1.0f, (float) sched_p), 0.0f, 1.0f);
+                    src = ggml_add(ctx0, src, ggml_mul(ctx0, m, ggml_sub(ctx0, t, src)));
+                }
+                ggml_tensor * tmpl = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, T, T);
+                ggml_tensor * jm = ggml_repeat(ctx0, ggml_reshape_2d(ctx0, t, T, 1), tmpl);                     // [j, t] = j
+                ggml_tensor * sm = ggml_repeat(ctx0, ggml_reshape_2d(ctx0, src, 1, T), tmpl);                   // [j, t] = src(t)
+                ggml_tensor * S  = ggml_relu(ctx0, ggml_scale_bias(ctx0, ggml_abs(ctx0, ggml_sub(ctx0, jm, sm)), -1.0f, 1.0f));
+                router_logits = ggml_mul_mat(ctx0, ggml_cont(ctx0, ggml_transpose(ctx0, per_tok)), S);         // [E*layers, T]
+            } else if (pool_n > 0 && pool_mode == 3) {
+                // frequency vote: per sparse layer, every pooled token votes for its top-k experts; experts ranked by
+                // vote count, ties broken by the mean logit (scaled far below one vote)
+                const int64_t n_sp = router_logits->ne[0] / n_expert;
+                ggml_tensor * lv = ggml_cont(ctx0, ggml_view_2d(ctx0, router_logits, router_logits->ne[0], np, router_logits->nb[1], p0 * router_logits->nb[1]));
+                ggml_tensor * l3 = ggml_reshape_3d(ctx0, lv, n_expert, n_sp, np);                       // [E, layers, tok]
+                ggml_tensor * top = ggml_argsort_top_k(ctx0, l3, vote_k);                               // [k, layers, tok] i32
+                ggml_tensor * eye = ggml_diag(ctx0, ggml_fill(ctx0, ggml_new_tensor_1d(ctx0, GGML_TYPE_F32, n_expert), 1.0f)); // [E, E]
+                ggml_tensor * oh  = ggml_get_rows(ctx0, eye, ggml_reshape_1d(ctx0, ggml_cont(ctx0, top), vote_k * n_sp * np)); // [E, k*layers*tok]
+                oh = ggml_reshape_4d(ctx0, oh, n_expert, vote_k, n_sp, np);                            // [E, k, layers, tok]
+                ggml_tensor * cnt = ggml_sum_rows(ctx0, ggml_cont(ctx0, ggml_permute(ctx0, oh, 1, 0, 2, 3))); // [1, E, layers, tok]
+                cnt = ggml_reshape_3d(ctx0, cnt, n_expert, n_sp, np);                                  // [E, layers, tok]
+                cnt = ggml_sum_rows(ctx0, ggml_cont(ctx0, ggml_permute(ctx0, cnt, 1, 2, 0, 3)));       // [1, E, layers]
+                cnt = ggml_reshape_2d(ctx0, cnt, n_expert, n_sp);                                      // votes per (expert, layer)
+                ggml_tensor * ml = ggml_reshape_2d(ctx0, ggml_mean(ctx0, ggml_cont(ctx0, ggml_transpose(ctx0, lv))), n_expert, n_sp);
+                router_logits = ggml_reshape_2d(ctx0, ggml_add(ctx0, cnt, ggml_scale(ctx0, ml, 1e-3f)), router_logits->ne[0], 1);
+            } else if (pool_n > 0 && pool_mode != 0) {
+                ggml_tensor * lv = ggml_view_2d(ctx0, router_logits, router_logits->ne[0], np, router_logits->nb[1], p0 * router_logits->nb[1]);
+                if (pool_mode == 2) { lv = ggml_sigmoid(ctx0, lv); }
+                router_logits = ggml_reshape_2d(ctx0, ggml_mean(ctx0, ggml_cont(ctx0, ggml_transpose(ctx0, lv))), router_logits->ne[0], 1);
+            }
+            if (pool_n > 0) {
+                const int64_t T = x->ne[1];
+                const int64_t nh = hybrid ? std::min<int64_t>(pool_n, T) : T;                     // tokens that use the pooled choice
+                ggml_tensor * pooled = ggml_repeat(ctx0, router_logits, ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, router_logits->ne[0], nh));
+                if (nh < T) {
+                    ggml_tensor * rest = ggml_view_2d(ctx0, per_tok, per_tok->ne[0], T - nh, per_tok->nb[1], nh * per_tok->nb[1]);
+                    router_logits = ggml_concat(ctx0, pooled, ggml_cont(ctx0, rest), 1);
+                } else {
+                    router_logits = pooled;
+                }
+            }
+            cb(router_logits, "ifp_router_logits", il);
+                };
+        if (il == n_dense && !route_at_ffn) { route_block(x); }
+
+        ggml_tensor * cur;
+        {
+            ggml_tensor * Qcur = build_lora_mm(layer.wq, x);
+            Qcur = ggml_reshape_3d(ctx0, Qcur, n_embd_head, n_head, n_tokens);
+            Qcur = ggml_rms_norm(ctx0, Qcur, hparams.f_norm_rms_eps);
+            Qcur = rope(Qcur);
+            Qcur = ggml_mul(ctx0, Qcur, layer.attn_q_norm);
+            cb(Qcur, "Qcur", il);
+
+            if (hparams.has_kv(il)) {
+                ggml_tensor * Kcur = build_lora_mm(layer.wk, x);
+                ggml_tensor * Vcur = build_lora_mm(layer.wv, x);
+                Kcur = ggml_reshape_3d(ctx0, Kcur, n_embd_head, n_head_kv, n_tokens);
+                Vcur = ggml_reshape_3d(ctx0, Vcur, n_embd_head, n_head_kv, n_tokens);
+                Kcur = ggml_rms_norm(ctx0, Kcur, hparams.f_norm_rms_eps);
+                Kcur = rope(Kcur);
+                if (layer.attn_k_norm) {
+                    Kcur = ggml_mul(ctx0, Kcur, layer.attn_k_norm);
+                }
+                if (kvq) {
+                    const float ks = hparams.k_quant_scale[il];
+                    const float vs = hparams.v_quant_scale[il];
+                    if (ks > 0) { Kcur = fq8(Kcur, ks); }
+                    if (vs > 0) { Vcur = fq8(Vcur, vs); }
+                }
+                cb(Kcur, "Kcur", il);
+                cb(Vcur, "Vcur", il);
+                cur = build_attn(inp_attn, layer.wo, NULL, Qcur, Kcur, Vcur, nullptr, nullptr, nullptr,
+                                 attn_scale, il);
+            } else {
+                cur = build_attn(inp_attn, layer.wo, NULL, Qcur, nullptr, nullptr, nullptr, nullptr, nullptr,
+                                 attn_scale, il);
+            }
+        }
+
+        if (il == n_layer - 1 && inp_out_ids) {
+            cur = ggml_get_rows(ctx0, cur, inp_out_ids);
+            x   = ggml_get_rows(ctx0, x,   inp_out_ids);
+            if (router_logits) {
+                router_logits = ggml_get_rows(ctx0, router_logits, inp_out_ids);
+            }
+        }
+
+        cur = build_norm(cur, layer.attn_post_norm, NULL, LLM_NORM_RMS, il);
+        if (f16_act >= 3) { cur = f16r(cur); }
+        ggml_tensor * hp = ggml_add(ctx0, x, cur);
+        if (f16_act >= 1) { hp = f16r(hp); }
+        cb(hp, "attn_out", il);
+
+        ggml_tensor * y = build_norm(hp, layer.ffn_norm, NULL, LLM_NORM_RMS, il);
+        if (il == n_dense && route_at_ffn) { route_block(y); }   // research: router on the layer-12 FFN input
+        cb(y, "ffn_in", il);
+
+        ggml_tensor * f;
+        if (il < n_dense) {
+            f = build_ffn(y,
+                    layer.ffn_up,   NULL, NULL,
+                    layer.ffn_gate, NULL, NULL,
+                    layer.ffn_down, NULL, NULL,
+                    NULL, LLM_FFN_SILU, LLM_FFN_PAR, il);
+        } else {
+            ggml_tensor * shared = build_ffn(y,
+                    layer.ffn_up_shexp,   NULL, NULL,
+                    layer.ffn_gate_shexp, NULL, NULL,
+                    layer.ffn_down_shexp, NULL, NULL,
+                    NULL, LLM_FFN_SILU, LLM_FFN_PAR, il);
+            cb(shared, "ffn_shexp", il);
+
+            const int64_t n_tok = y->ne[1];
+            ggml_tensor * lg = ggml_view_2d(ctx0, router_logits, n_expert, n_tok, router_logits->nb[1],
+                                            (size_t) (il - n_dense) * n_expert * ggml_element_size(router_logits));
+            lg = ggml_cont(ctx0, lg);
+            cb(lg, "ffn_moe_logits", il);
+            ggml_tensor * sel = ggml_argsort_top_k(ctx0, lg, n_used); // [n_expert_used, n_tok]
+            cb(sel, "ffn_moe_topk", il);
+
+            ggml_tensor * y3 = ggml_reshape_3d(ctx0, y, n_embd, 1, n_tok);
+            ggml_tensor * up = build_lora_mm_id(layer.ffn_up_exps,   y3, sel); // [n_ff_exp, n_used, n_tok]
+            ggml_tensor * gt = build_lora_mm_id(layer.ffn_gate_exps, y3, sel);
+            ggml_tensor * act = ggml_swiglu_split(ctx0, gt, up);
+            ggml_tensor * ex  = build_lora_mm_id(layer.ffn_down_exps, act, sel); // [n_embd, n_used, n_tok]
+            cb(ex, "ffn_moe_down", il);
+
+            // unweighted sum over the selected experts: [n_embd, n_used, n_tok] -> [n_embd, n_tok]
+            ggml_tensor * moe = ggml_sum_rows(ctx0, ggml_cont(ctx0, ggml_permute(ctx0, ex, 1, 0, 2, 3)));
+            moe = ggml_reshape_2d(ctx0, moe, n_embd, n_tok);
+            cb(moe, "ffn_moe_out", il);
+            f = no_routed ? shared : (no_shexp ? moe : ggml_add(ctx0, moe, shared));
+        }
+        f = build_norm(f, layer.ffn_post_norm, NULL, LLM_NORM_RMS, il);
+        if (f16_act >= 3) { f = f16r(f); }
+        h = ggml_add(ctx0, y, f);
+        if (f16_act >= 1) { h = f16r(h); }
+        h = build_cvec(h, il);
+        cb(h, "l_out", il);
+    }
+
+    ggml_tensor * cur = build_norm(h,   model.output_norm,   NULL, LLM_NORM_RMS, -1);
+    cur               = build_norm(cur, model.output_norm_2, NULL, LLM_NORM_RMS, -1);
+    cb(cur, "result_norm", -1);
+    res->t_embd = cur;
+
+    cur = build_lora_mm(model.output, cur);
+    cb(cur, "result_output", -1);
+    res->t_logits = cur;
+
+    ggml_build_forward_expand(gf, cur);
+}
