index 000000000..a7d65fab5
--- /dev/null
+++ b/src/models/afm.cpp
@@ -0,0 +1,592 @@
+#include "models.h"
+#include "../llama-adapter.h"
+
+#include <algorithm>
+#include <array>
+#include <cstdlib>
+#include <cmath>
+#include <cstdio>
+#include <string>
+#include <vector>
+
+static float afm_env_f(const char * k, float d) { const char * v = getenv(k); return v ? (float) atof(v) : d; }
+
+// A multi-token run of one sequence is either a prompt chunk or a speculative-decoding verify batch ([last token, draft
+// tokens...]). Verify batches request logits for every token and never start at position 0; prompt chunks request at
+// most their last token. Tokens of a verify batch must behave exactly as if decoded one at a time (Apple's extend path),
+// so that speculation cannot change the output.
+static std::vector<bool> afm_gen_runs(const llama_ubatch * ub) {
+    const int64_t T = ub->n_tokens;
+    std::vector<bool> gen(T, false);
+    for (int64_t i = 0; i < T; ++i) {
+        int64_t cnt = 0; bool all_out = true; llama_pos p0 = ub->pos[i];
+        for (int64_t j = 0; j < T; ++j) {
+            if (ub->seq_id[j][0] != ub->seq_id[i][0]) { continue; }
+            cnt++; all_out = all_out && ub->output && ub->output[j]; p0 = std::min(p0, ub->pos[j]);
+        }
+        gen[i] = cnt > 1 && all_out && p0 > 0 && !getenv("AFM_NO_SPEC_RUNS");
+    }
+    return gen;
+}
+
+// Per-ubatch indices for Apple's IFP expert schedule (TokenGenerationInference.IFPExpertPicker):
+//  - a run of >1 tokens of one sequence is a prompt chunk: all of its tokens use the router logits of the chunk's LAST
+//    token, which become the sequence's persisted choice;
+//  - a single decode token re-picks from its own logits when pos % freq == 0, otherwise reuses the persisted choice.
+class llm_graph_input_afm_route : public llm_graph_input_i {
+public:
+    llm_graph_input_afm_route(int64_t n_slots, int64_t freq, bool prompt_own, std::vector<std::array<int32_t, 2>> * tags)
+        : n_slots(n_slots), freq(freq), prompt_own(prompt_own), tags(tags) {}
+    // Each sequence slot keeps two persisted picks, tagged with the position of the token they came from. A pick from a
+    // position at or after the first position of this batch belongs to tokens that were rolled back (rejected draft
+    // tokens of speculative decoding, or a cleared cache) and is ignored; a new pick goes to the other row.
+    void set_input(const llama_ubatch * ub) override {
+        const int64_t T = ub->n_tokens, discard = 2*n_slots;
+        std::vector<int32_t> ist(T), itk(T); std::vector<int64_t> idst(T, discard); std::vector<float> use(T, 1.0f);
+        const std::vector<bool> gen = afm_gen_runs(ub);
+        std::vector<llama_seq_id> seqs;
+        for (int64_t i = 0; i < T; ++i) {
+            if (std::find(seqs.begin(), seqs.end(), ub->seq_id[i][0]) == seqs.end()) { seqs.push_back(ub->seq_id[i][0]); }
+        }
+        for (const llama_seq_id s : seqs) {
+            const int64_t slot = ((s % n_slots) + n_slots) % n_slots;
+            std::vector<int64_t> idx;
+            for (int64_t i = 0; i < T; ++i) { if (ub->seq_id[i][0] == s) { idx.push_back(i); } }
+            llama_pos p0 = ub->pos[idx[0]]; int64_t last = idx[0];
+            for (int64_t i : idx) { p0 = std::min(p0, ub->pos[i]); if (ub->pos[i] >= ub->pos[last]) { last = i; } }
+            auto & tg = (*tags)[slot];
+            for (auto & q : tg) { if (q >= p0) { q = -1; } }
+            const int valid = tg[1] > tg[0] ? 1 : 0, wr = 1 - valid;
+            const int32_t rd = (int32_t) (2*slot + valid);
+            int64_t writer = -1;                                  // token whose fresh logits become the persisted pick
+            const bool multi = idx.size() > 1;
+            for (int64_t i : idx) {
+                ist[i] = rd; itk[i] = (int32_t) i;
+                if (multi && gen[i]) {
+                    // verify batch: as single decode tokens -- route on the latest re-pick token (position % freq == 0) at or
+                    // before this one in the batch, else on the persisted pick
+                    int64_t src = -1;
+                    for (int64_t j : idx) {
+                        if (ub->pos[j] % freq != 0) { continue; }
+                        if (ub->pos[j] <= ub->pos[i] && (src < 0 || ub->pos[j] > ub->pos[src])) { src = j; }
+                        if (writer < 0 || ub->pos[j] > ub->pos[writer]) { writer = j; }
+                    }
+                    if (src >= 0) { itk[i] = (int32_t) src; } else { use[i] = 0.0f; }
+                } else if (multi) {
+                    // prompt chunk: every token routes on the chunk's last token, which becomes the persisted pick
+                    if (!prompt_own) { itk[i] = (int32_t) last; }
+                    writer = last;
+                } else if (ub->pos[i] % freq == 0) {
+                    writer = i;                                   // a lone decode token at a re-pick position
+                } else {
+                    use[i] = 0.0f;
+                }
+            }
+            if (writer >= 0) { idst[writer] = 2*slot + wr; tg[wr] = ub->pos[writer]; }
+        }
+        ggml_backend_tensor_set(src_state, ist.data(), 0, T*sizeof(int32_t));
+        ggml_backend_tensor_set(src_tok,   itk.data(), 0, T*sizeof(int32_t));
+        ggml_backend_tensor_set(dst,       idst.data(), 0, T*sizeof(int64_t));
+        ggml_backend_tensor_set(use_tok,   use.data(), 0, T*sizeof(float));
+    }
+    bool can_reuse(const llm_graph_params & params) override { return src_tok->ne[0] == (int64_t) params.ubatch.n_tokens; }
+    ggml_tensor * src_state = nullptr; // I32 [T]   persisted row to read
+    ggml_tensor * src_tok   = nullptr; // I32 [T]   in-batch token whose fresh logits to read
+    ggml_tensor * dst       = nullptr; // I64 [T]   row to write this token's fresh logits to (2*n_slots = discard)
+    ggml_tensor * use_tok   = nullptr; // F32 [1,T] 1 = fresh logits, 0 = persisted
+    const int64_t n_slots, freq;
+    const bool    prompt_own;   // prompt-chunk tokens route on their own logits (the pick for generation is unchanged)
+    std::vector<std::array<int32_t, 2>> * tags;
+};
+
+// Apple runs prompt chunks through the prompt_opt procedures, whose layer-0 constant is zero, and generated tokens through
+// the extend procedures, which add the input bias. 1 = this token gets the bias: a lone token of its sequence in the
+// ubatch (a decode step); 0 = part of a multi-token run of one sequence (a prompt chunk).
+class llm_graph_input_afm_bias_mask : public llm_graph_input_i {
+public:
+    explicit llm_graph_input_afm_bias_mask(int64_t freq) : freq(freq) {}
+    void set_input(const llama_ubatch * ub) override {
+        const int64_t T = ub->n_tokens;
+        std::vector<float> m(T);
+        const std::vector<bool> gen = afm_gen_runs(ub);
+        for (int64_t i = 0; i < T; ++i) {
+            int64_t cnt = 0;
+            for (int64_t j = 0; j < T; ++j) { cnt += ub->seq_id[j][0] == ub->seq_id[i][0]; }
+            // a re-pick token (position a multiple of the selection frequency) runs Apple's dense-only function: no bias;
+            // tokens of a speculative verify batch are generated tokens like a lone decode token
+            m[i] = ((cnt == 1 || gen[i]) && (freq <= 0 || ub->pos[i] % freq != 0)) ? 1.0f : 0.0f;
+        }
+        ggml_backend_tensor_set(t, m.data(), 0, T*sizeof(float));
+    }
+    bool can_reuse(const llm_graph_params & params) override { return t->ne[1] == (int64_t) params.ubatch.n_tokens; }
+    ggml_tensor * t = nullptr;   // F32 [1, T]
+    const int64_t freq;
+};
+
+// research: Neural Engine elementwise functions as exact lookup tables. AFM_ANE_SILU=<file> holds 65536 fp16 outputs
+// indexed by the fp16 bit pattern of the input (tabulated on the ANE through CoreML); the input is rounded to fp16
+// first, as on the ANE. CPU custom op (the scheduler runs it on the CPU backend).
+static const uint16_t * afm_load_lut(const char * env) {
+    static std::vector<std::pair<std::string, std::vector<uint16_t>>> cache;
+    const char * path = getenv(env);
+    if (!path) { return nullptr; }
+    for (auto & c : cache) { if (c.first == path) { return c.second.data(); } }
+    std::vector<uint16_t> t(65536);
+    FILE * f = fopen(path, "rb");
+    if (!f || fread(t.data(), 2, 65536, f) != 65536) { fprintf(stderr, "%s: cannot read 65536 fp16 from %s\n", env, path); if (f) fclose(f); return nullptr; }
+    fclose(f); cache.push_back({path, std::move(t)}); return cache.back().second.data();
+}
+static void afm_lut_op(ggml_tensor * dst, const ggml_tensor * a, int ith, int nth, void * ud) {
+    const uint16_t * tab = (const uint16_t *) ud;
+    const int64_t n = ggml_nelements(dst), per = (n + nth - 1) / nth, i0 = per * ith, i1 = std::min<int64_t>(n, i0 + per);
+    const float * x = (const float *) a->data; float * y = (float *) dst->data;
+    for (int64_t i = i0; i < i1; ++i) { y[i] = ggml_fp16_to_fp32((ggml_fp16_t) tab[(uint16_t) ggml_fp32_to_fp16(x[i])]); }
+}
+
+// research: AFM_ROUTE_FORCE=<file> replaces the router logits of a batch with float32 [T, n_expert * n_sparse_layers]
+// read from the file (row t = token t); only the top-k selection matters, the routed experts are summed unweighted
+class llm_graph_input_afm_force : public llm_graph_input_i {
+public:
+    explicit llm_graph_input_afm_force(const char * path) : path(path) {}
+    void set_input(const llama_ubatch *) override {
+        std::vector<float> buf(ggml_nelements(t), 0.0f);
+        if (FILE * f = fopen(path.c_str(), "rb")) {
+            const size_t n = fread(buf.data(), sizeof(float), buf.size(), f); fclose(f);
+            if (n != buf.size()) { fprintf(stderr, "AFM_ROUTE_FORCE: %s has %zu of %zu floats\n", path.c_str(), n, buf.size()); }
+        } else { fprintf(stderr, "AFM_ROUTE_FORCE: cannot read %s\n", path.c_str()); }
+        ggml_backend_tensor_set(t, buf.data(), 0, ggml_nbytes(t));
+    }
+    bool can_reuse(const llm_graph_params &) override { return false; }
+    ggml_tensor * t = nullptr;
+    std::string path;
+};
+
+// Apple Foundation Model, on-device "afmplus-v11.2-ifp" (3B, Instruction-Following-Pruned sparse FFN).
+//
+//   L0:   x = embd (+ inp_bias on generated tokens only; prompt chunks and re-pick tokens add nothing, as in Apple's
+//         prompt_opt and dense-only re-pick procedures)
+//         embd = int4 code * per-token scale; no multiplier, no norm on the first layer input
+//   L>0:  x = rms(h) * layer_out_norm[L-1]
+//         h'  = x + rms(attn(x)) * attn_post_norm                   (post-LN "x/y" residual: residual is the
+//         y   = rms(h') * ffn_norm                                    normalised stream, not raw h)
+//         h   = y + rms(ffn(y)) * ffn_post_norm
+//   attn: q = rms(rope_neox(Wq x)) * q_norm ; k likewise (k_norm optional) ; GQA ; layers >= kv_reuse_first
+//         reuse the K/V cache of the last KV-owning layer
+//   ffn:  dense SwiGLU for the first n_layer_dense_lead layers; afterwards an UNWEIGHTED sum of a shared SwiGLU
+//         (the always-on experts) and n_expert_used routed SwiGLU experts. The routing logits for all sparse layers
+//         come from one small router network evaluated on the layer-n_layer_dense_lead input x.
+//   routing schedule (Apple's IFPExpertPicker): the router runs on ONE token, not per token -- the last token of
+//         the prompt picks the experts for every prompt token and for generation, and a decode token re-picks only
+//         when its position is a multiple of 32. The choice persists per sequence in model.afm_route_state.
+//   out:  logits = (rms(rms(h) * output_norm) * output_norm_2) @ tok_embd^T
+llm_build_afm::llm_build_afm(const llama_model & model, const llm_graph_params & params) : llm_graph_context(params) {
+    const int64_t n_embd_head = hparams.n_embd_head_k;
+    const int     n_dense     = (int) hparams.n_layer_dense_lead;
+
+    ggml_tensor * inpL = build_inp_embd(model.tok_embd);
+    // research knobs (unset = model defaults): AFM_KSCALE, AFM_NO_SHEXP, AFM_NO_ROUTED, AFM_NUSED, AFM_KVQ=0,
+    // AFM_ROUTE_POOL/_START/_MODE (pool router input over a token range), AFM_ROUTE_CUM (causal prefix-mean routing)
+    const float kscale    = afm_env_f("AFM_KSCALE", 1.0f);   // research multiplier; Apple applies none
+    const bool  no_shexp  = afm_env_f("AFM_NO_SHEXP", 0) != 0;
+    const bool  no_routed = afm_env_f("AFM_NO_ROUTED", 0) != 0;
+    // IFP configuration (Apple config.json): ifp1/ifp2/ifp3 = 5/14/23 always-on experts (a prefix of the 23 stored) plus as
+    // many routed experts. The base model and the FM API use ifp3; feature adapters declare their own (lora_i1/i2/i3).
+    // the active feature adapter (an AFM LoRA written by afm2gguf --adapter) declares its IFP level in adapter.afm.ifp
+    int ifp_from_adapter = 0;
+    if (loras) {
+        for (const auto & [ad, sc] : *loras) {
+            if (sc == 0.0f) { continue; }
+            auto it = ad->gguf_kv.find("adapter.afm.ifp");
+            if (it != ad->gguf_kv.end()) { ifp_from_adapter = std::max(ifp_from_adapter, atoi(it->second.c_str())); }
+        }
+    }
+    const int   ifp       = (int) afm_env_f("AFM_IFP", ifp_from_adapter ? (float) ifp_from_adapter : 3.0f);
+    const int   n_static  = ifp == 1 ? 5 : ifp == 2 ? 14 : (int) (hparams.n_ff_shexp / hparams.n_ff_exp);
+    const int   n_used    = (int) afm_env_f("AFM_NUSED", ifp == 1 ? 5.0f : ifp == 2 ? 14.0f : (float) n_expert_used);
+    const bool  kvq       = afm_env_f("AFM_KVQ", 1) != 0; // default on when the GGUF carries scales
+    const int   pool_n    = (int) afm_env_f("AFM_ROUTE_POOL", 0);
+    const int   pool_s    = (int) afm_env_f("AFM_ROUTE_POOL_START", 0);
+    const int   pool_mode = (int) afm_env_f("AFM_ROUTE_POOL_MODE", 0); // 0 mean input, 1 mean logits, 2 mean sigmoid, 3 vote
+    const int   vote_k    = (int) afm_env_f("AFM_ROUTE_VOTE_K", 32);     // mode 3: each pooled token votes for its top-k experts
+    const bool  hybrid    = afm_env_f("AFM_ROUTE_HYBRID", 0) != 0;      // pooled experts for tokens < pool_n, per-token after
+    // Apple's schedule (TokenGenerationInference IFPExpertPicker): experts for the whole prompt come from the router on the
+    // LAST prompt token; during generation they are re-picked from the current token at absolute positions p % FREQ == 0.
+    // AFM_ROUTE_SCHED=<prompt length> applies it to a teacher-forced batch that starts at position 0.
+    const int   sched_p   = (int) afm_env_f("AFM_ROUTE_SCHED", 0);
+    const int   sched_f   = (int) afm_env_f("AFM_ROUTE_FREQ", 32);
+    const int   sched_lag = (int) afm_env_f("AFM_ROUTE_SCHED_LAG", 0);   // 1: a boundary pick takes effect one token later
+    const bool  route_at_ffn = afm_env_f("AFM_ROUTE_AT_FFN", 0) != 0;      // research: router input = layer-12 FFN input
+    const bool  prompt_own   = afm_env_f("AFM_ROUTE_PROMPT_OWN", 0) != 0;  // prompt tokens per-token; generation keeps Apple's pick
+    const float attn_scale   = hparams.f_attention_scale * afm_env_f("AFM_ATTN_SCALE_MUL", 1.0f);   // research multiplier
+    const int   f16_act      = (int) afm_env_f("AFM_F16_ACT", 0);          // research: round activations to fp16 (1: residual, 2: +router input, 3: +attn/ffn outputs)
+    auto f16r = [&](ggml_tensor * t) { return ggml_cast(ctx0, ggml_cast(ctx0, t, GGML_TYPE_F16), GGML_TYPE_F32); };
+    const bool mm16 = afm_env_f("AFM_MM_F16", 0) != 0;   // research: round every matmul / attention output to fp16 (as the ANE stores them)
+    auto r16 = [&](ggml_tensor * t) { return mm16 ? f16r(t) : t; };
+    // emulate the ANE int8 KV cache: x -> clamp(round(x*s), -127, 127) / s
+    const int kvq_mode = (int) afm_env_f("AFM_KVQ_MODE", 0);   // research: 0 round-half-even, 1 truncate toward zero
+    auto fq8 = [&](ggml_tensor * t, float s) {
+        if (kvq_mode == 1) {   // trunc(x*s) = sign(x)*floor(|x*s|), floor(a) = round(a - 0.5) for a >= 0 (ties do not matter here)
+            ggml_tensor * a  = ggml_abs(ctx0, ggml_scale(ctx0, t, s));
+            ggml_tensor * fl = ggml_scale_bias(ctx0, ggml_scale_bias(ctx0, ggml_scale_bias(ctx0, a, 1.0f, -0.4999f), 1.0f, 12582912.0f), 1.0f, -12582912.0f);
+            return ggml_scale(ctx0, ggml_mul(ctx0, ggml_clamp(ctx0, fl, 0.0f, 127.0f), ggml_sgn(ctx0, t)), 1.0f/s);
+        }
+        // round-to-nearest via the fp32 magic constant 1.5*2^23 (backend-independent), saturate to int8, rescale
+        ggml_tensor * r = ggml_scale_bias(ctx0, t, s, 12582912.0f);
+        r = ggml_scale_bias(ctx0, r, 1.0f, -12582912.0f);
+        return ggml_scale(ctx0, ggml_clamp(ctx0, r, -127.0f, 127.0f), 1.0f/s); };
+    const bool  route_cum = afm_env_f("AFM_ROUTE_CUM", 0) != 0;
+    const bool  gamma_first = afm_env_f("AFM_QK_GAMMA_FIRST", 0) != 0;   // research: q/k gain before RoPE
+    const uint16_t * lut_silu = afm_load_lut("AFM_ANE_SILU");          // research: ANE SiLU table for the FFNs
+    const uint16_t * lut_silu_r = afm_load_lut("AFM_ANE_SILU_ROUTER"); // research: ANE SiLU table for the router
+    auto lut_apply = [&](ggml_tensor * t, const uint16_t * tab) {
+        return ggml_map_custom1(ctx0, ggml_cont(ctx0, t), afm_lut_op, GGML_N_TASKS_MAX, (void *) tab); };
+    auto ffn_lut = [&](ggml_tensor * yy, ggml_tensor * wu, ggml_tensor * wg, ggml_tensor * wd) {
+        ggml_tensor * u = build_lora_mm(wu, yy), * g = build_lora_mm(wg, yy);
+        return build_lora_mm(wd, ggml_mul(ctx0, lut_apply(g, lut_silu), u)); };
+    // Apple's Neural Engine SiLU (default; AFM_EXACT_SILU=1 uses the exact function): piecewise-linear table on a
+    // 0.5 grid, y = v[i] + d[i]*frac + relu(x - 8.5), i = floor(2x + 21) clamped to [0, 37], result rounded to fp16
+    const bool ane_silu = model.afm_silu_v && !lut_silu && afm_env_f("AFM_EXACT_SILU", 0) == 0;
+    auto silu_ane = [&](ggml_tensor * t) -> ggml_tensor * {
+        ggml_tensor * x  = ggml_cont(ctx0, t);
+        ggml_tensor * x1 = ggml_reshape_1d(ctx0, x, ggml_nelements(x));
+        ggml_tensor * u  = ggml_clamp(ctx0, ggml_scale_bias(ctx0, x1, 2.0f, 21.0f), 0.0f, 37.999f);
+        // floor(u) = round(u - 0.5) via the fp32 magic constant (the -0.5 must be its own step: 1.5*2^23 - 0.5 is not
+        // representable in fp32); at an exact knot this may pick the left segment with frac 1, which gives the same value
+        ggml_tensor * fl = ggml_scale_bias(ctx0, ggml_scale_bias(ctx0, ggml_scale_bias(ctx0, u, 1.0f, -0.5f), 1.0f, 12582912.0f), 1.0f, -12582912.0f);
+        fl = ggml_clamp(ctx0, fl, 0.0f, 37.0f);
+        ggml_tensor * fr = ggml_sub(ctx0, u, fl);
+        ggml_tensor * ix = ggml_cast(ctx0, fl, GGML_TYPE_I32);
+        ggml_tensor * vv = ggml_reshape_1d(ctx0, ggml_get_rows(ctx0, model.afm_silu_v, ix), ggml_nelements(x));
+        ggml_tensor * dd = ggml_reshape_1d(ctx0, ggml_get_rows(ctx0, model.afm_silu_d, ix), ggml_nelements(x));
+        ggml_tensor * y  = ggml_add(ctx0, ggml_add(ctx0, vv, ggml_mul(ctx0, dd, fr)), ggml_relu(ctx0, ggml_scale_bias(ctx0, x1, 1.0f, -8.5f)));
+        y = ggml_cast(ctx0, ggml_cast(ctx0, y, GGML_TYPE_F16), GGML_TYPE_F32);
+        return ggml_reshape(ctx0, y, x);
+    };
+    auto ffn_ane = [&](ggml_tensor * yy, ggml_tensor * wu, ggml_tensor * wg, ggml_tensor * wd) {
+        ggml_tensor * u = r16(build_lora_mm(wu, yy)), * g = r16(build_lora_mm(wg, yy));
+        return r16(build_lora_mm(wd, r16(ggml_mul(ctx0, silu_ane(g), u)))); };
+    if (ubatch.token) {
+        inpL = ggml_scale(ctx0, inpL, kscale);
+    }
+    if (afm_env_f("AFM_INBIAS_MUL", 1.0f) != 0.0f) {   // research: AFM_INBIAS_MUL scales (0 removes) the layer-0 input bias
+        ggml_tensor * bias = ggml_scale(ctx0, model.inp_bias, afm_env_f("AFM_INBIAS_MUL", 1.0f));
+        ggml_tensor * m = nullptr;   // [1, T]: which tokens get the bias
+        const int from = (int) afm_env_f("AFM_INBIAS_FROM", afm_env_f("AFM_ROUTE_SCHED", 0));
+        if (afm_env_f("AFM_INBIAS_ALL", 0) != 0) {
+            // research: bias on every token (the pre-2026-11-08 behaviour)
+        } else if (from > 0) {
+            // teacher-forced batch from position 0 with a prompt of `from` tokens: bias on the answer positions only
+            ggml_tensor * t = ggml_arange(ctx0, 0.0f, (float) n_tokens, 1.0f);
+            m = ggml_reshape_2d(ctx0, ggml_clamp(ctx0, ggml_scale_bias(ctx0, t, 1.0f, 1.0f - (float) from), 0.0f, 1.0f), 1, n_tokens);
+            if (afm_env_f("AFM_INBIAS_SKIP_REPICK", 1) != 0) {
+                // research: re-pick tokens (positions >= from that are multiples of 32) run Apple's dense-only function, no bias
+                const int f = (int) afm_env_f("AFM_ROUTE_FREQ", 32);
+                ggml_tensor * fl = ggml_scale_bias(ctx0, ggml_scale_bias(ctx0, ggml_scale_bias(ctx0, t, 1.0f/f, -0.5f + 0.5f/f), 1.0f, 12582912.0f), 1.0f, -12582912.0f);
+                ggml_tensor * isb = ggml_clamp(ctx0, ggml_scale_bias(ctx0, ggml_abs(ctx0, ggml_sub(ctx0, ggml_scale(ctx0, fl, (float) f), t)), -1.0f, 1.0f), 0.0f, 1.0f); // 1 at multiples of f
+                m = ggml_sub(ctx0, m, ggml_mul(ctx0, m, ggml_reshape_2d(ctx0, isb, 1, n_tokens)));
+            }
+        } else {
+            auto inp = std::make_unique<llm_graph_input_afm_bias_mask>(afm_env_f("AFM_INBIAS_SKIP_REPICK", 1) != 0 ? sched_f : 0);
+            inp->t = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, 1, n_tokens); ggml_set_input(inp->t);
+            m = inp->t; res->add_input(std::move(inp));
+        }
+        if (m) { bias = ggml_mul(ctx0, ggml_repeat(ctx0, ggml_reshape_2d(ctx0, bias, n_embd, 1), inpL), m); }
+        inpL = ggml_add(ctx0, inpL, bias);
+    }
+    cb(inpL, "inp_scaled", -1);
+
+    ggml_tensor * inp_pos     = build_inp_pos();
+    auto        * inp_attn    = build_attn_inp_kv();
+    ggml_tensor * inp_out_ids = build_inp_out_ids();
+
+    // research (teacher-forced batches starting at position 0 only): AFM_ROPE_F16=1 computes the RoPE angles the way an
+    // fp16 pipeline would (fp16 position x fp16 inverse frequency, rounded to fp16); 2 also rounds cos/sin to fp16;
+    // 9 = the same custom path in fp32 (must equal ggml_rope_ext)
+    const int rope_f16 = (int) afm_env_f("AFM_ROPE_F16", 0);
+    ggml_tensor * rope_c = nullptr, * rope_s = nullptr;
+    if (rope_f16) {
+        const int64_t T = n_tokens, hd2 = n_rot/2;
+        auto rnd = [&](ggml_tensor * t) { return rope_f16 == 9 ? t : f16r(t); };
+        ggml_tensor * pp  = rnd(ggml_arange(ctx0, 0.0f, (float) T, 1.0f));
+        ggml_tensor * inv = rnd(ggml_exp(ctx0, ggml_scale(ctx0, ggml_arange(ctx0, 0.0f, (float) hd2, 1.0f), -2.0f*logf(freq_base)/n_rot)));
+        ggml_tensor * tm  = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, hd2, T);
+        ggml_tensor * th  = rnd(ggml_mul(ctx0, ggml_repeat(ctx0, ggml_reshape_2d(ctx0, inv, hd2, 1), tm),
+                                              ggml_repeat(ctx0, ggml_reshape_2d(ctx0, pp, 1, T), tm)));
+        rope_c = ggml_cos(ctx0, th); rope_s = ggml_sin(ctx0, th);
+        if (rope_f16 == 2) { rope_c = f16r(rope_c); rope_s = f16r(rope_s); }
+        rope_c = ggml_reshape_3d(ctx0, rope_c, hd2, 1, T); rope_s = ggml_reshape_3d(ctx0, rope_s, hd2, 1, T);
+        // keep inp_pos in the graph (it is still set every ubatch even though this path does not read it)
+        ggml_build_forward_expand(gf, ggml_rope_ext(ctx0, ggml_fill(ctx0, ggml_new_tensor_3d(ctx0, GGML_TYPE_F32, n_rot, 1, T), 0.0f),
+                                                    inp_pos, nullptr, n_rot, rope_type, n_ctx_orig, freq_base, freq_scale,
+                                                    ext_factor, attn_factor, beta_fast, beta_slow));
+    }
+    auto rope = [&](ggml_tensor * t) -> ggml_tensor * {
+        if (!rope_f16) {
+            return ggml_rope_ext(ctx0, t, inp_pos, nullptr, n_rot, rope_type, n_ctx_orig, freq_base, freq_scale,
+                                 ext_factor, attn_factor, beta_fast, beta_slow);
+        }
+        const int64_t hd2 = n_rot/2;   // NEOX: rotate (i, i + n_rot/2)
+        ggml_tensor * a = ggml_cont(ctx0, ggml_view_3d(ctx0, t, hd2, t->ne[1], t->ne[2], t->nb[1], t->nb[2], 0));
+        ggml_tensor * b = ggml_cont(ctx0, ggml_view_3d(ctx0, t, hd2, t->ne[1], t->ne[2], t->nb[1], t->nb[2], hd2*t->nb[0]));
+        ggml_tensor * o1 = ggml_sub(ctx0, ggml_mul(ctx0, a, rope_c), ggml_mul(ctx0, b, rope_s));
+        ggml_tensor * o2 = ggml_add(ctx0, ggml_mul(ctx0, b, rope_c), ggml_mul(ctx0, a, rope_s));
+        return ggml_concat(ctx0, o1, o2, 0);
+    };
+
+    ggml_tensor * h             = nullptr;
+    ggml_tensor * router_logits = nullptr; // [n_expert * n_sparse_layers, n_tokens]
+
+    for (int il = 0; il < n_layer; ++il) {
+        const auto & layer = model.layers[il];
+
+        ggml_tensor * x = il == 0 ? inpL : build_norm(h, model.layers[il - 1].layer_out_norm, NULL, LLM_NORM_RMS, il);
+        if (il == (int) afm_env_f("AFM_X_FORCE_LAYER", -1) && getenv("AFM_X_FORCE")) {
+            // research: replace this layer's input with float32 [T, n_embd] from a file (e.g. computed on the ANE)
+            auto inp = std::make_unique<llm_graph_input_afm_force>(getenv("AFM_X_FORCE"));
+            inp->t = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, n_embd, x->ne[1]); ggml_set_input(inp->t);
+            x = ggml_add(ctx0, ggml_scale(ctx0, x, 0.0f), inp->t);   // keep the earlier graph alive (inputs stay allocated)
+            res->add_input(std::move(inp));
+        }
+        cb(x, "attn_in", il);
+
+        auto route_block = [&](ggml_tensor * x) {
+            if (f16_act >= 2) { x = f16r(x); }   // Apple's expert state is an fp16 tensor
+            ggml_tensor * r_in = x;
+            const int64_t p0 = std::min<int64_t>(pool_s, x->ne[1] - 1);
+            const int64_t np = std::max<int64_t>(1, std::min<int64_t>(pool_n, x->ne[1]) - p0);
+            if (pool_n > 0 && pool_mode == 0) {
+                ggml_tensor * xv = ggml_view_2d(ctx0, x, n_embd, np, x->nb[1], p0 * x->nb[1]);
+                r_in = ggml_reshape_2d(ctx0, ggml_mean(ctx0, ggml_cont(ctx0, ggml_transpose(ctx0, xv))), n_embd, 1);
+            }
+            if (route_cum && pool_n == 0) {
+                // causal prefix mean of the router input: r_t = mean_{s<=t} x_s
+                const int64_t T = x->ne[1];
+                ggml_tensor * tri = ggml_diag_mask_zero(ctx0, ggml_fill(ctx0, ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, T, T), 1.0f), 0);
+                tri = ggml_div(ctx0, tri, ggml_sum_rows(ctx0, tri));
+                r_in = ggml_mul_mat(ctx0, ggml_cont(ctx0, ggml_transpose(ctx0, x)), tri);
+            }
+            auto router_net = [&](ggml_tensor * in) {
+                ggml_tensor * r = build_lora_mm(layer.ifp_router_fc1, in);
+                r = ggml_add(ctx0, r, layer.ifp_router_fc1_b);
+                r = lut_silu_r ? lut_apply(r, lut_silu_r) : ggml_silu(ctx0, r);
+                r = build_norm(r, layer.ifp_router_norm, NULL, LLM_NORM_RMS, il);
+                r = build_lora_mm(layer.ifp_router_fc2, r);
+                return ggml_add(ctx0, r, layer.ifp_router_fc2_b);
+            };
+            router_logits = router_net(r_in);
+            ggml_tensor * per_tok = (r_in == x) ? router_logits : router_net(x);                    // [E*layers, T]
+            const bool apple_sched = model.afm_route_state && afm_env_f("AFM_ROUTE_TOKEN", 0) == 0 && pool_n == 0 && !route_cum &&
+                                     !getenv("AFM_ROUTE_FORCE");
+            if (apple_sched && sched_p == 0) {
+                auto inp = std::make_unique<llm_graph_input_afm_route>(LLAMA_AFM_ROUTE_SLOTS, std::max(1, sched_f), prompt_own, &model.afm_route_pos);
+                const int64_t T = per_tok->ne[1];
+                inp->src_state = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, T); ggml_set_input(inp->src_state);
+                inp->src_tok   = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, T); ggml_set_input(inp->src_tok);
+                inp->dst       = ggml_new_tensor_1d(ctx0, GGML_TYPE_I64, T); ggml_set_input(inp->dst);
+                inp->use_tok   = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, 1, T); ggml_set_input(inp->use_tok);
+                ggml_tensor * fresh = ggml_get_rows(ctx0, per_tok, inp->src_tok);                       // [E*layers, T]
+                ggml_tensor * kept  = ggml_get_rows(ctx0, model.afm_route_state, inp->src_state);       // [E*layers, T]
+                router_logits = ggml_add(ctx0, kept, ggml_mul(ctx0, ggml_sub(ctx0, fresh, kept), inp->use_tok));
+                // read the persisted choice BEFORE this batch overwrites it (a verify batch can hold both readers and a re-pick)
+                ggml_build_forward_expand(gf, router_logits);
+                ggml_build_forward_expand(gf, ggml_set_rows(ctx0, model.afm_route_state, per_tok, inp->dst));
+                res->add_input(std::move(inp));
+            } else if (sched_p > 0) {
+                // src(t) = max(P-1, F*floor((t-lag)/F)); one-hot selection S[j,t] = [j == src(t)], logits = per_tok @ S
+                const int64_t T = x->ne[1];
+                ggml_tensor * t  = ggml_arange(ctx0, 0.0f, (float) T, 1.0f);                                   // [T]
+                ggml_tensor * fl = ggml_scale_bias(ctx0, t, 1.0f/sched_f, -(sched_lag + 0.5f*(sched_f - 1))/sched_f);
+                fl = ggml_scale_bias(ctx0, ggml_scale_bias(ctx0, fl, 1.0f, 12582912.0f), 1.0f, -12582912.0f); // round
+                ggml_tensor * src = ggml_clamp(ctx0, ggml_scale(ctx0, fl, (float) sched_f), (float) (sched_p - 1), 1e9f);
+                if (prompt_own) {   // m = 1 for t < P (t integer), src = m*t + (1-m)*src
+                    ggml_tensor * m = ggml_clamp(ctx0, ggml_scale_bias(ctx0, t, -1.0f, (float) sched_p), 0.0f, 1.0f);
+                    src = ggml_add(ctx0, src, ggml_mul(ctx0, m, ggml_sub(ctx0, t, src)));
+                }
+                ggml_tensor * tmpl = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, T, T);
+                ggml_tensor * jm = ggml_repeat(ctx0, ggml_reshape_2d(ctx0, t, T, 1), tmpl);                     // [j, t] = j
+                ggml_tensor * sm = ggml_repeat(ctx0, ggml_reshape_2d(ctx0, src, 1, T), tmpl);                   // [j, t] = src(t)
+                ggml_tensor * S  = ggml_relu(ctx0, ggml_scale_bias(ctx0, ggml_abs(ctx0, ggml_sub(ctx0, jm, sm)), -1.0f, 1.0f));
+                router_logits = ggml_mul_mat(ctx0, ggml_cont(ctx0, ggml_transpose(ctx0, per_tok)), S);         // [E*layers, T]
+            } else if (pool_n > 0 && pool_mode == 3) {
+                // frequency vote: per sparse layer, every pooled token votes for its top-k experts; experts ranked by
+                // vote count, ties broken by the mean logit (scaled far below one vote)
+                const int64_t n_sp = router_logits->ne[0] / n_expert;
+                ggml_tensor * lv = ggml_cont(ctx0, ggml_view_2d(ctx0, router_logits, router_logits->ne[0], np, router_logits->nb[1], p0 * router_logits->nb[1]));
+                ggml_tensor * l3 = ggml_reshape_3d(ctx0, lv, n_expert, n_sp, np);                       // [E, layers, tok]
+                ggml_tensor * top = ggml_argsort_top_k(ctx0, l3, vote_k);                               // [k, layers, tok] i32
+                ggml_tensor * eye = ggml_diag(ctx0, ggml_fill(ctx0, ggml_new_tensor_1d(ctx0, GGML_TYPE_F32, n_expert), 1.0f)); // [E, E]
+                ggml_tensor * oh  = ggml_get_rows(ctx0, eye, ggml_reshape_1d(ctx0, ggml_cont(ctx0, top), vote_k * n_sp * np)); // [E, k*layers*tok]
+                oh = ggml_reshape_4d(ctx0, oh, n_expert, vote_k, n_sp, np);                            // [E, k, layers, tok]
+                ggml_tensor * cnt = ggml_sum_rows(ctx0, ggml_cont(ctx0, ggml_permute(ctx0, oh, 1, 0, 2, 3))); // [1, E, layers, tok]
+                cnt = ggml_reshape_3d(ctx0, cnt, n_expert, n_sp, np);                                  // [E, layers, tok]
+                cnt = ggml_sum_rows(ctx0, ggml_cont(ctx0, ggml_permute(ctx0, cnt, 1, 2, 0, 3)));       // [1, E, layers]
+                cnt = ggml_reshape_2d(ctx0, cnt, n_expert, n_sp);                                      // votes per (expert, layer)
+                ggml_tensor * ml = ggml_reshape_2d(ctx0, ggml_mean(ctx0, ggml_cont(ctx0, ggml_transpose(ctx0, lv))), n_expert, n_sp);
+                router_logits = ggml_reshape_2d(ctx0, ggml_add(ctx0, cnt, ggml_scale(ctx0, ml, 1e-3f)), router_logits->ne[0], 1);
+            } else if (pool_n > 0 && pool_mode != 0) {
+                ggml_tensor * lv = ggml_view_2d(ctx0, router_logits, router_logits->ne[0], np, router_logits->nb[1], p0 * router_logits->nb[1]);
+                if (pool_mode == 2) { lv = ggml_sigmoid(ctx0, lv); }
+                router_logits = ggml_reshape_2d(ctx0, ggml_mean(ctx0, ggml_cont(ctx0, ggml_transpose(ctx0, lv))), router_logits->ne[0], 1);
+            }
+            if (pool_n > 0) {
+                const int64_t T = x->ne[1];
+                const int64_t nh = hybrid ? std::min<int64_t>(pool_n, T) : T;                     // tokens that use the pooled choice
+                ggml_tensor * pooled = ggml_repeat(ctx0, router_logits, ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, router_logits->ne[0], nh));
+                if (nh < T) {
+                    ggml_tensor * rest = ggml_view_2d(ctx0, per_tok, per_tok->ne[0], T - nh, per_tok->nb[1], nh * per_tok->nb[1]);
+                    router_logits = ggml_concat(ctx0, pooled, ggml_cont(ctx0, rest), 1);
+                } else {
+                    router_logits = pooled;
+                }
+            }
+            cb(router_logits, "ifp_router_logits", il);
+            if (const char * fp = getenv("AFM_ROUTE_FORCE")) {
+                auto inp = std::make_unique<llm_graph_input_afm_force>(fp);
+                inp->t = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, router_logits->ne[0], x->ne[1]); ggml_set_input(inp->t);
+                router_logits = inp->t;
+                res->add_input(std::move(inp));
+            }
+                };
+        if (il == n_dense && !route_at_ffn) { route_block(x); }
+
+        ggml_tensor * cur;
+        {
+            ggml_tensor * Qcur = r16(build_lora_mm(layer.wq, x));
+            Qcur = ggml_reshape_3d(ctx0, Qcur, n_embd_head, n_head, n_tokens);
+            Qcur = ggml_rms_norm(ctx0, Qcur, hparams.f_norm_rms_eps);
+            if (gamma_first) {   // research: gain before RoPE
+                Qcur = rope(ggml_mul(ctx0, Qcur, layer.attn_q_norm));
+            } else {
+                Qcur = rope(Qcur);
+                Qcur = ggml_mul(ctx0, Qcur, layer.attn_q_norm);
+            }
+            cb(Qcur, "Qcur", il);
+
+            if (hparams.has_kv(il)) {
+                ggml_tensor * Kcur = r16(build_lora_mm(layer.wk, x));
+                ggml_tensor * Vcur = r16(build_lora_mm(layer.wv, x));
+                Kcur = ggml_reshape_3d(ctx0, Kcur, n_embd_head, n_head_kv, n_tokens);
+                Vcur = ggml_reshape_3d(ctx0, Vcur, n_embd_head, n_head_kv, n_tokens);
+                Kcur = ggml_rms_norm(ctx0, Kcur, hparams.f_norm_rms_eps);
+                const bool kq_pre_gamma = afm_env_f("AFM_KQ_PRE_GAMMA", 0) != 0 && layer.attn_k_norm && kvq;   // research
+                if (gamma_first && layer.attn_k_norm) { Kcur = ggml_mul(ctx0, Kcur, layer.attn_k_norm); }
+                Kcur = rope(Kcur);
+                if (gamma_first) {
+                } else if (layer.attn_k_norm && !kq_pre_gamma) {
+                    Kcur = ggml_mul(ctx0, Kcur, layer.attn_k_norm);
+                } else if (const char * g = getenv("AFM_K_GAMMA_FROM")) {   // research: borrow a gain for a K without one
+                    const int src = atoi(g);
+                    ggml_tensor * gm = src < 0 ? layer.attn_q_norm : model.layers[src].attn_k_norm;
+                    if (gm) { Kcur = ggml_mul(ctx0, Kcur, gm); }
+                }
+                if (kvq && il >= (int) afm_env_f("AFM_KVQ_FROM", 0)) {   // research: AFM_KVQ_FROM=n skips int8 emulation below layer n
+                    float ks = hparams.k_quant_scale[il];
+                    if (ks == 0 && getenv("AFM_KQ_MISSING")) { ks = afm_env_f("AFM_KQ_MISSING", 0); }   // research: int8 K for layers without a decoded scale
+                    const float vs = hparams.v_quant_scale[il];
+                    if (ks > 0) { Kcur = fq8(Kcur, ks); }
+                    // research: AFM_V0_INSCALE=c quantizes layer-0 V as if its input were c times larger (only the int8
+                    // resolution changes: the attention output is RMS-normalised afterwards)
+                    const float c0 = il == 0 ? afm_env_f("AFM_V0_INSCALE", 1.0f) : 1.0f;
+                    if (vs > 0) { Vcur = c0 == 1.0f ? fq8(Vcur, vs) : ggml_scale(ctx0, fq8(ggml_scale(ctx0, Vcur, c0), vs), 1.0f/c0); }
+                }
+                if (kq_pre_gamma) { Kcur = ggml_mul(ctx0, Kcur, layer.attn_k_norm); }   // dequantised cache times the gain
+                cb(Kcur, "Kcur", il);
+                cb(Vcur, "Vcur", il);
+                cur = build_attn(inp_attn, mm16 ? nullptr : layer.wo, NULL, Qcur, Kcur, Vcur, nullptr, nullptr, nullptr,
+                                 attn_scale, il);
+            } else {
+                cur = build_attn(inp_attn, mm16 ? nullptr : layer.wo, NULL, Qcur, nullptr, nullptr, nullptr, nullptr, nullptr,
+                                 attn_scale, il);
+            }
+            if (mm16) { cur = r16(build_lora_mm(layer.wo, r16(cur))); }
+        }
+
+        if (il == n_layer - 1 && inp_out_ids) {
+            cur = ggml_get_rows(ctx0, cur, inp_out_ids);
+            x   = ggml_get_rows(ctx0, x,   inp_out_ids);
+            if (router_logits) {
+                router_logits = ggml_get_rows(ctx0, router_logits, inp_out_ids);
+            }
+        }
+
+        cur = build_norm(cur, layer.attn_post_norm, NULL, LLM_NORM_RMS, il);
+        if (il == 0 && getenv("AFM_L0_ATTN_MUL")) { cur = ggml_scale(ctx0, cur, afm_env_f("AFM_L0_ATTN_MUL", 1.0f)); }   // research
+        if (f16_act >= 3) { cur = f16r(cur); }
+        ggml_tensor * hp = ggml_add(ctx0, x, cur);
+        if (f16_act >= 1) { hp = f16r(hp); }
+        cb(hp, "attn_out", il);
+
+        ggml_tensor * y = build_norm(hp, layer.ffn_norm, NULL, LLM_NORM_RMS, il);
+        if (il == n_dense && route_at_ffn) { route_block(y); }   // research: router on the layer-12 FFN input
+        cb(y, "ffn_in", il);
+
+        ggml_tensor * f;
+        if (il < n_dense && lut_silu) {
+            f = ffn_lut(y, layer.ffn_up, layer.ffn_gate, layer.ffn_down);
+        } else if (il < n_dense && ane_silu) {
+            f = ffn_ane(y, layer.ffn_up, layer.ffn_gate, layer.ffn_down);
+        } else if (il < n_dense) {
+            f = build_ffn(y,
+                    layer.ffn_up,   NULL, NULL,
+                    layer.ffn_gate, NULL, NULL,
+                    layer.ffn_down, NULL, NULL,
+                    NULL, LLM_FFN_SILU, LLM_FFN_PAR, il);
+        } else {
+            ggml_tensor * up_s = layer.ffn_up_shexp, * gate_s = layer.ffn_gate_shexp, * down_s = layer.ffn_down_shexp;
+            if (n_static * hparams.n_ff_exp < (int64_t) hparams.n_ff_shexp) {
+                // ifp1/ifp2: the first n_static always-on experts (256-aligned, so whole Q2_K blocks)
+                const int64_t w = n_static * hparams.n_ff_exp;
+                up_s   = ggml_view_2d(ctx0, up_s,   up_s->ne[0],   w, up_s->nb[1],   0);
+                gate_s = ggml_view_2d(ctx0, gate_s, gate_s->ne[0], w, gate_s->nb[1], 0);
+                down_s = ggml_view_2d(ctx0, down_s, w, down_s->ne[1], down_s->nb[1], 0);
+            }
+            ggml_tensor * shared = lut_silu ? ffn_lut(y, up_s, gate_s, down_s) :
+                                   ane_silu ? ffn_ane(y, up_s, gate_s, down_s) :
+                build_ffn(y,
+                    up_s,   NULL, NULL,
+                    gate_s, NULL, NULL,
+                    down_s, NULL, NULL,
+                    NULL, LLM_FFN_SILU, LLM_FFN_PAR, il);
+            cb(shared, "ffn_shexp", il);
+
+            const int64_t n_tok = y->ne[1];
+            ggml_tensor * lg = ggml_view_2d(ctx0, router_logits, n_expert, n_tok, router_logits->nb[1],
+                                            (size_t) (il - n_dense) * n_expert * ggml_element_size(router_logits));
+            lg = ggml_cont(ctx0, lg);
+            cb(lg, "ffn_moe_logits", il);
+            ggml_tensor * sel = ggml_argsort_top_k(ctx0, lg, n_used); // [n_expert_used, n_tok]
+            cb(sel, "ffn_moe_topk", il);
+
+            ggml_tensor * y3 = ggml_reshape_3d(ctx0, y, n_embd, 1, n_tok);
+            ggml_tensor * up = r16(build_lora_mm_id(layer.ffn_up_exps,   y3, sel)); // [n_ff_exp, n_used, n_tok]
+            ggml_tensor * gt = r16(build_lora_mm_id(layer.ffn_gate_exps, y3, sel));
+            ggml_tensor * act = lut_silu ? ggml_mul(ctx0, lut_apply(gt, lut_silu), up) :
+                                ane_silu ? ggml_mul(ctx0, silu_ane(gt), up) : ggml_swiglu_split(ctx0, gt, up);
+            ggml_tensor * ex  = r16(build_lora_mm_id(layer.ffn_down_exps, r16(act), sel)); // [n_embd, n_used, n_tok]
+            cb(ex, "ffn_moe_down", il);
+
+            // unweighted sum over the selected experts: [n_embd, n_used, n_tok] -> [n_embd, n_tok]
+            ggml_tensor * moe = ggml_sum_rows(ctx0, ggml_cont(ctx0, ggml_permute(ctx0, ex, 1, 0, 2, 3)));
+            moe = ggml_reshape_2d(ctx0, moe, n_embd, n_tok);
+            cb(moe, "ffn_moe_out", il);
+            f = no_routed ? shared : (no_shexp ? moe : ggml_add(ctx0, moe, shared));
+        }
+        f = build_norm(f, layer.ffn_post_norm, NULL, LLM_NORM_RMS, il);
+        if (f16_act >= 3) { f = f16r(f); }
+        h = ggml_add(ctx0, y, f);
+        if (f16_act >= 1) { h = f16r(h); }
+        h = build_cvec(h, il);
+        cb(h, "l_out", il);
+    }
+
+    ggml_tensor * cur = build_norm(h,   model.output_norm,   NULL, LLM_NORM_RMS, -1);
+    cur               = build_norm(cur, model.output_norm_2, NULL, LLM_NORM_RMS, -1);
+    cb(cur, "result_norm", -1);
+    res->t_embd = cur;
+
+    cur = build_lora_mm(model.output, cur);
+    cb(cur, "result_output", -1);
+    res->t_logits = cur;
+
+    ggml_build_forward_expand(gf, cur);
+}
